                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentButton}" Content="Görsel" Command="{Binding UseVisualWritingCommand}" Tag="{Binding IsVisualWriting}" AutomationProperties.Name="Görsel yazma" />
                                            <Button Style="{StaticResource SegmentButton}" Content="Metin" Command="{Binding UseTextWritingCommand}" Tag="{Binding IsTextWriting}" AutomationProperties.Name="Metin olarak yazma" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Yazma görünümü" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Görsel: yazarken iş listedeki gibi görünür. Metin: düz yazı, - ile alt iş." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Davranış -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SettingsTabBehave, Converter={StaticResource Visible}}">
                        <TextBlock Text="BAŞLANGIÇ VE TEPSİ" Style="{StaticResource SettingsGroup}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                              IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Windows açılınca başlat" />
                                    <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="StartWithWindowsLabel_Click">
                                        <TextBlock Text="Windows açılınca başlat" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Pencere açılmaz, sağ alttaki sistem tepsisinde bekler." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                              IsChecked="{Binding CloseToTray}" AutomationProperties.Name="Çarpıya basınca sistem tepsisine küçült" />
                                    <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="CloseToTrayLabel_Click">
                                        <TextBlock Text="Çarpıya basınca tepsiye küçült" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Simgeye tık: bugünün işleri, çift tık: uygulama, sağ tık: Çıkış." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="GÜN SONU" Style="{StaticResource SettingsGroup}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                              IsChecked="{Binding DayEndOn}" AutomationProperties.Name="Gün sonu hatırlatması" />
                                    <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="DayEndLabel_Click">
                                        <TextBlock Text="Gün sonu hatırlatması" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Bu saatte bugün açık iş kaldıysa sağ altta haber verir, günde bir kez. Bildirime tıklayınca bugünün işleri açılır." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}" IsEnabled="{Binding DayEndOn}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" Command="{Binding EarlierDayEndCommand}"
                                                ToolTip="15 dk önce" AutomationProperties.Name="Hatırlatmayı 15 dakika öne al" />
                                        <TextBlock Text="{Binding DayEndTimeText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" Command="{Binding LaterDayEndCommand}"
                                                ToolTip="15 dk sonra" AutomationProperties.Name="Hatırlatmayı 15 dakika sonraya al" />
                                    </StackPanel>
                                    <TextBlock Text="Saat" Style="{StaticResource SettingsName}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="HATIRLATICILAR" Style="{StaticResource SettingsGroup}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                              IsChecked="{Binding TimedRemindersOn}" AutomationProperties.Name="Hatırlatıcılar" />
                                    <StackPanel>
                                        <TextBlock Text="Hatırlatıcılar" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Hatırlatıcısı olan iş yaklaşınca sağ altta haber verir. Hatırlatıcı sağ panelden kurulur." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <!-- What a task newly given a time gets, stepped like the evening time: Yok, Tam saatinde, 5 dk … 1 gün -->
                                <StackPanel IsEnabled="{Binding TimedRemindersOn}">
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" Command="{Binding EarlierFirstReminderCommand}"
                                                ToolTip="Daha yakın" AutomationProperties.Name="1. hatırlatma: daha yakın" />
                                        <TextBlock Text="{Binding FirstReminderText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" MinWidth="96" TextAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" Command="{Binding LaterFirstReminderCommand}"
                                                ToolTip="Daha önce" AutomationProperties.Name="1. hatırlatma: daha önce" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="1. hatırlatma" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Yeni hatırlatıcıda" Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}" IsEnabled="{Binding CanSetSecondReminder}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" Command="{Binding EarlierSecondReminderCommand}"
                                                ToolTip="Daha yakın" AutomationProperties.Name="2. hatırlatma: daha yakın" />
                                        <TextBlock Text="{Binding SecondReminderText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" MinWidth="96" TextAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" Command="{Binding LaterSecondReminderCommand}"
                                                ToolTip="Daha önce" AutomationProperties.Name="2. hatırlatma: daha önce" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="2. hatırlatma" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Yeni hatırlatıcıda" Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Eşitleme -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SettingsTabSync, Converter={StaticResource Visible}}">
                        <StackPanel Visibility="{Binding CanSync, Converter={StaticResource Visible}}">
                            <TextBlock Text="GOOGLE DRIVE" Style="{StaticResource SettingsGroup}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingsRow}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Hesabı bağla" Command="{Binding ConnectDriveCommand}"
                                                    Visibility="{Binding IsDriveDisconnected, Converter={StaticResource Visible}}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Şimdi eşitle" Command="{Binding SyncNowCommand}"
                                                    Visibility="{Binding IsDriveConnected, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Telefonla eşitleme" Style="{StaticResource SettingsName}" />
                                            <TextBlock Text="{Binding DriveStatus}" Style="{StaticResource SettingsNote}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding IsDriveConnected, Converter={StaticResource Visible}}">
                                        <Border Style="{StaticResource SettingsDivider}" />
                                        <DockPanel Style="{StaticResource SettingsRow}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Bağlantıyı kes" Command="{Binding DisconnectDriveCommand}"
                                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="Hesap" Style="{StaticResource SettingsName}" />
                                                <TextBlock Text="Notların Drive'daki İş Günlüğü klasörüyle eşitlenir, telefondan da erişirsin." Style="{StaticResource SettingsNote}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="DOSYALAR" Style="{StaticResource SettingsGroup}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Ekle…" Command="{Binding ImportFileCommand}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Metin belgesi ekle" />
                                    <StackPanel>
                                        <TextBlock Text="Metin belgesi ekle" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Kopyası Belgeler'deki İş Günlüğü klasörüne alınır, orijinaline dokunulmaz." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Aç" Command="{Binding OpenBackupsCommand}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Gün gün alınan kopyaların klasörünü açar" AutomationProperties.Name="Yedekleri aç" />
                                    <StackPanel>
                                        <TextBlock Text="Günlük yedekler" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Her gün notlarının bir kopyası bu bilgisayarda saklanır, son 30 gün durur." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Yardım -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SettingsTabHelp, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource SettingsCard}" Padding="0,2">
                            <StackPanel>
                                <Button Style="{StaticResource SettingsLinkRow}" Command="{Binding OpenUserGuideCommand}">
                                    <StackPanel><TextBlock Text="Kullanım kılavuzu" Style="{StaticResource SettingsName}" /><TextBlock Text="Görselli kılavuz, uygulamanın içinde." Style="{StaticResource SettingsNote}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SettingsLinkRow}" Click="ShowGuide_Click">
                                    <StackPanel><TextBlock Text="Adım adım tanıtım" Style="{StaticResource SettingsName}" /><TextBlock Text="Bulunduğun ekranı birkaç adımda anlatır." Style="{StaticResource SettingsNote}" /></StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                              IsChecked="{Binding TourInvitesOn}" AutomationProperties.Name="Tanıtım davetleri" />
                                    <StackPanel>
                                        <TextBlock Text="Tanıtım davetleri" Style="{StaticResource SettingsName}" />
                                        <TextBlock Text="Bir ekrana ilk geldiğinde sağ üstte küçük bir davet çıkar; basınca o ekran birkaç adımda anlatılır." Style="{StaticResource SettingsNote}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <Button Style="{StaticResource SettingsLinkRow}" Command="{Binding ResetToursCommand}">
                                    <StackPanel><TextBlock Text="Tanıtımı sıfırla" Style="{StaticResource SettingsName}" /><TextBlock Text="Görülen bölümler unutulur, davetler en baştan başlar." Style="{StaticResource SettingsNote}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SettingsLinkRow}" Click="ShowShortcuts_Click">
                                    <StackPanel><TextBlock Text="Kısayollar" Style="{StaticResource SettingsName}" /><TextBlock Text="Klavyeyle neler yapılır (F1)." Style="{StaticResource SettingsNote}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SettingsLinkRow}" Command="{Binding ShowReleaseNotesCommand}">
                                    <StackPanel><TextBlock Text="Sürüm notları" Style="{StaticResource SettingsName}" /><TextBlock Text="Hangi sürümde ne değişti." Style="{StaticResource SettingsNote}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SettingsLinkRow}" Command="{Binding OpenErrorLogCommand}">
                                    <StackPanel><TextBlock Text="Hata günlüğü" Style="{StaticResource SettingsName}" /><TextBlock Text="Beklenmeyen hataların kaydı; bir sorun bildirirken işe yarar." Style="{StaticResource SettingsNote}" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Sync: a quiet notice, and the choice between two versions -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{Binding ConflictBanner}" Command="{Binding OpenConflictCommand}" HorizontalAlignment="Center"
                    Visibility="{Binding HasConflicts, Converter={StaticResource Visible}}" />
            <Border Background="{DynamicResource CellBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                    Visibility="{Binding HasHeldDeletions, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeldBanner}" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Geri getir" Command="{Binding RestoreHeldCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Silinsin" Command="{Binding ConfirmHeldCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Background="#80000000" Visibility="{Binding IsConflictOpen, Converter={StaticResource Visible}}">
            <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="24,20" Width="600" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}"
                                Command="{Binding CloseConflictCommand}" ToolTip="Sonra karar ver" AutomationProperties.Name="Kapat" />
                        <TextBlock Text="Farklılık bulundu" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ConflictFile}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
                    <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="1" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bilgisayar" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsLocalNewer, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Daha yeni" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ConflictLocalTime}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Telefon" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsRemoteNewer, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Daha yeni" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ConflictRemoteTime}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <!-- The newer side is the suggestion: a filled button that says so; the other stays plain. -->
                        <Button Style="{StaticResource PrimaryButton}" Content="Telefondakini kullan · önerilen" Margin="0,0,8,0" Command="{Binding KeepRemoteCommand}"
                                Visibility="{Binding IsRemoteNewer, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Telefondakini kullan" Margin="0,0,8,0" Command="{Binding KeepRemoteCommand}"
                                Visibility="{Binding IsRemoteNewer, Converter={StaticResource Collapsed}}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Bilgisayardakini kullan · önerilen" Command="{Binding KeepLocalCommand}"
                                Visibility="{Binding IsLocalNewer, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Bilgisayardakini kullan" Command="{Binding KeepLocalCommand}"
                                Visibility="{Binding IsLocalNewer, Converter={StaticResource Collapsed}}" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding ConflictRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="{Binding Tag}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Release notes -->
        <!-- Release notes, laid out as Settings: the versions on the left, the picked one's notes in white cards on the grey page -->
        <Grid x:Name="ReleaseNotesScrim" Background="#80000000" Visibility="{Binding IsReleaseNotesOpen, Converter={StaticResource Visible}}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">
            <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Width="700" MaxHeight="560" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="0,0,0,1" Padding="24,16,20,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}"
                                    Command="{Binding CloseReleaseNotesCommand}" ToolTip="Kapat (Esc)" AutomationProperties.Name="Sürüm notlarını kapat" />
                            <TextBlock Text="Sürüm notları" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Left" Width="180" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding ReleaseTabs}" Focusable="False" Margin="10,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding PickCommand}" Click="ReleaseTab_Click" Cursor="Hand" Margin="0,0,0,2" AutomationProperties.Name="{Binding Version}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,6">
                                                        <StackPanel>
                                                            <TextBlock x:Name="Number" Text="{Binding Version}" FontSize="14" Foreground="{DynamicResource InkBrush}" />
                                                            <TextBlock Text="{Binding Day}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                            <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer x:Name="ReleaseScroll" VerticalScrollBarVisibility="Auto" Focusable="False" Background="{DynamicResource CellBrush}">
                        <ItemsControl ItemsSource="{Binding ReleaseSections}" Focusable="False" Margin="18,14,18,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="2,2,0,6">
                                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock x:Name="SectionTitle" Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <StackPanel Margin="14,8">
                                                                <!-- A head in bold over its faint detail; an item that does not split reads as plain text -->
                                                                <TextBlock Text="{Binding Head}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                                                           Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource SettingsDivider}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="new">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="SectionTitle" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="changed">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PartialBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="fixed">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DoneBrush}" />
                                            <Setter TargetName="SectionTitle" Property="Foreground" Value="{DynamicResource DoneBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- First-use tour: darkens the window except the part it talks about, with a card beside that part -->
        <Canvas x:Name="GuideLayer" Background="Transparent" Visibility="Collapsed">
            <Path x:Name="GuideDim" Fill="#99000000" IsHitTestVisible="False" />
            <Border x:Name="GuideRing" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
            <Border x:Name="GuideCard" Width="380" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5" CornerRadius="8" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="GuideStepText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                    <Grid Height="4" Margin="0,5,0,8">
                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="2" />
                        <Border x:Name="GuideProgress" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock x:Name="GuideTitle" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,4" TextWrapping="Wrap" />
                    <ContentControl x:Name="GuideArtHost" Focusable="False" />
                    <TextBlock x:Name="GuideText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <DockPanel>
                        <Button x:Name="GuideNextButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="GuideNext_Click" />
                        <Button x:Name="GuideBackButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Geri" Margin="0,0,8,0" Click="GuideBack_Click" />
                        <Button Style="{StaticResource LinkButton}" Content="Bu bölümü geç" HorizontalAlignment="Left" Click="GuideSkip_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- First run, or the saved file is gone. A steady brand panel on the left, the current step on the right. -->
        <Grid Background="{DynamicResource WindowBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFile}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Padding="40">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#0B6A6F" Offset="0" />
                        <GradientStop Color="#0A4B50" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Image Source="app.ico" Width="34" Height="34" />
                        <TextBlock Text="İş Günlüğü" FontSize="20" FontWeight="SemiBold" Foreground="#F2FBFB" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <Border VerticalAlignment="Bottom" Background="#1CFFFFFF" CornerRadius="10" Padding="16,14">
                        <Grid>
                            <StackPanel Visibility="{Binding IsFirstRunWelcome, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="15" Height="15" CornerRadius="4" Background="#5DBB83" />
                                    <TextBlock Text="Raporu gönder" Foreground="#E4F5F5" FontSize="14" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <Border Width="15" Height="15" CornerRadius="4" Background="#EBBC3F" />
                                    <TextBlock Text="Sunum hazırlığı  1/3" Foreground="#E4F5F5" FontSize="14" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <Border Width="15" Height="15" CornerRadius="4" BorderBrush="#F08A5D" BorderThickness="2" />
                                    <TextBlock Text="Faturayı öde" Foreground="#E4F5F5" FontSize="14" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding FirstRunHint}" Foreground="#E4F5F5" FontSize="14" TextWrapping="Wrap" LineHeight="21" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Button Style="{StaticResource QuietLink}" Content="← Geri" Command="{Binding FirstRunBackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,24,0,0"
                        Visibility="{Binding CanFirstRunGoBack, Converter={StaticResource Visible}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,40,0"
                            Visibility="{Binding IsFirstRunNewPath, Converter={StaticResource Visible}}">
                    <Border Width="26" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                    <Border Width="26" Height="4" CornerRadius="2" Margin="5,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstRunDrive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <!-- Welcome -->
                    <StackPanel Visibility="{Binding IsFirstRunWelcome, Converter={StaticResource Visible}}">
                        <TextBlock Text="Hoş geldin" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,30" Foreground="{DynamicResource MutedBrush}"
                                   Text="Günlük işlerini sade metin dosyalarında tut, istersen telefonunla eşitle." />
                        <Button Style="{StaticResource PrimaryButton}" Content="Hızlı başlangıç" Command="{Binding QuickStartCommand}" Padding="16,13" FontSize="15" />
                        <Button Style="{StaticResource QuietLink}" Command="{Binding ReturningUserCommand}" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="Daha önce kullandım" TextDecorations="Underline" />
                        </Button>
                    </StackPanel>

                    <!-- New: first file -->
                    <StackPanel Visibility="{Binding IsFirstRunFile, Converter={StaticResource Visible}}">
                        <TextBlock Text="İlk dosyan" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,8,0,22" Foreground="{DynamicResource MutedBrush}" Text="Her konu için ayrı dosya tutabilirsin." />
                        <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="FirstFile" IsChecked="{Binding FirstFileCreates}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ChoiceIcon}" Text="+" />
                                <StackPanel>
                                    <TextBlock Text="Yeni dosya oluştur" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Adını sen ver" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding FirstFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Dosya adı"
                                 Visibility="{Binding FirstFileCreates, Converter={StaticResource Visible}}" />
                        <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="FirstFile" IsChecked="{Binding FirstFileImports}" Command="{Binding PickFirstImportCommand}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ChoiceIcon}" Text="&#x1F5CE;" />
                                <StackPanel>
                                    <TextBlock Text="Elimdeki metin belgesini ekle" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FirstImportLabel}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <Button Style="{StaticResource PrimaryButton}" Content="Devam" Command="{Binding FirstFileNextCommand}" Padding="16,13" FontSize="15" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- New: Drive, optional -->
                    <StackPanel Visibility="{Binding IsFirstRunDrive, Converter={StaticResource Visible}}">
                        <TextBlock Text="Telefonunla eşitle" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,30" Foreground="{DynamicResource MutedBrush}"
                                   Text="Google Drive'ı bağlarsan notların bilgisayarında ve telefonunda aynı kalır." />
                        <Button Style="{StaticResource PrimaryButton}" Content="Google Drive'ı bağla" Command="{Binding ConnectFirstDriveCommand}" IsEnabled="{Binding CanStartSignIn}" Padding="16,13" FontSize="15" />
                        <Button Style="{StaticResource QuietLink}" Command="{Binding SkipFirstDriveCommand}" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="Şimdilik atla" TextDecorations="Underline" />
                        </Button>
                    </StackPanel>

                    <!-- Returning: from where -->
                    <StackPanel Visibility="{Binding IsFirstRunSource, Converter={StaticResource Visible}}">
                        <TextBlock Text="Dosyalarını nereden getirelim?" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,8,0,22" Foreground="{DynamicResource MutedBrush}" Text="Sonra diğerini de ekleyebilirsin." />
                        <Button Style="{StaticResource ChoiceButton}" Command="{Binding FetchFromDriveCommand}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ChoiceIcon}" Text="&#x2601;" />
                                <StackPanel>
                                    <TextBlock Text="Google Drive" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Hesabını bağla, klasörlerinle birlikte gelsin" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource ChoiceButton}" Command="{Binding AddFromComputerCommand}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ChoiceIcon}" Text="&#x1F5A5;" />
                                <StackPanel>
                                    <TextBlock Text="Bu bilgisayardan" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Metin belgelerini seç, kopyaları alınır" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Returning: Drive -->
                    <StackPanel Visibility="{Binding IsFirstRunFetch, Converter={StaticResource Visible}}">
                        <TextBlock Text="Notların getiriliyor" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,10" Foreground="{DynamicResource MutedBrush}"
                                   Text="Drive'daki dosyaların inince uygulama kendiliğinden açılır." />
                        <Button Style="{StaticResource PrimaryButton}" Content="Hızlı başlangıç" Command="{Binding StartFreshCommand}" Padding="16,13" FontSize="15" Margin="0,18,0,0"
                                Visibility="{Binding IsDriveEmpty, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding FirstRunStatus}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding HasFirstRunStatus, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding FirstRunError}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource OpenBrush}"
                               Visibility="{Binding HasFirstRunError, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding FileError}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource OpenBrush}"
                               Visibility="{Binding HasFileError, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
        </Grid>

<!-- The user guide fills the window; after the first-run screen, since Settings opens it from there too -->
        <local:UserGuideView x:Name="UserGuide" Visibility="{Binding IsUserGuideOpen, Converter={StaticResource Visible}}" />

        <!-- Name of a file or a group; last, because it also opens over the first-run screen -->
        <Grid x:Name="NamePromptScrim" Background="#80000000" Visibility="{Binding IsNamePromptOpen, Converter={StaticResource Visible}}"
              IsVisibleChanged="NamePrompt_IsVisibleChanged" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">
            <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="24,20" Width="400"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding NamePromptTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox x:Name="NamePromptBox" Style="{StaticResource InputBox}" Text="{Binding NamePromptText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="NamePromptBox_PreviewKeyDown" AutomationProperties.Name="Ad" />
                    <TextBlock Text="{Binding NamePromptError}" FontSize="13" Foreground="{DynamicResource OpenBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasNamePromptError, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Tamam" Command="{Binding ConfirmNamePromptCommand}" ToolTip="Enter" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" Command="{Binding CancelNamePromptCommand}" Margin="8,0,0,0" ToolTip="Esc" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Deleting a file of the notes folder: asked first, since the sync takes it off Drive and the phone too -->
        <Grid x:Name="DeleteScrim" Background="#80000000" Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource Visible}}" IsVisibleChanged="DeleteScrim_IsVisibleChanged" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">
            <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="24,20" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteConfirmTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding DeleteConfirmText}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="DeleteYes" Style="{StaticResource PrimaryButton}" Content="Sil" Command="{Binding ConfirmDeleteCommand}" ToolTip="Enter" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" Command="{Binding CancelDeleteCommand}" Margin="8,0,0,0" IsCancel="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
