<Window x:Class="IsGunlugu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IsGunlugu"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="İş Günlüğü" Icon="app.ico" Width="1180" Height="900" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{StaticResource TextFont}"
        Foreground="{DynamicResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ToggleHelpCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowTodayCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowOpenCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowFutureCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowUndatedCommand}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShowAllCommand}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding ShowCalendarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:TrueToHiddenConverter x:Key="Hidden" />
        <sys:Double x:Key="YearDayHeight">22</sys:Double>
        <local:TrueToCollapsedConverter x:Key="Collapsed" />

        <DataTemplate x:Key="BodyItemTemplate">
            <StackPanel>
            <!-- On the first sub-task: the line for sub-tasks finished on earlier days -->
            <Border Visibility="{Binding HasFold, Converter={StaticResource Visible}}">
                <Button DataContext="{Binding FoldOwner}" Command="{Binding ToggleEarlierCommand}" Cursor="Hand" HorizontalAlignment="Left" Margin="-5,0,0,2"
                        ToolTip="Önceki günlerde biten alt işleri göster ya da gizle" AutomationProperties.Name="{Binding EarlierText}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="5,2,8,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasEarlier}" Value="True" />
                                        <Condition Binding="{Binding ShowBody}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DoneBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EarlierText}" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Margin="6,1,0,0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconRight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEarlierOpen}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconDown}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </StackPanel>
                </Button>
            </Border>
            <Grid x:Name="Item">
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" FontSize="13.5"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"
                         Visibility="{Binding IsNote, Converter={StaticResource Visible}}" />

                <Border x:Name="SubRow" Background="Transparent" CornerRadius="4" Margin="-5,0,0,0" Padding="5,2,2,2"
                        Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False"
                        Visibility="{Binding IsTask, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource StatusCheck}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0"
                              IsChecked="{Binding IsDone}" AutomationProperties.Name="{Binding Text}"
                              Visibility="{Binding IsStruck, Converter={StaticResource Hidden}}">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="0.84" ScaleY="0.84" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Border  Width="16" Height="16" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource MutedBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.7" ToolTip="Bu alt iş iptal edildi"
                            Visibility="{Binding IsStruck, Converter={StaticResource Visible}}">
                        <Path Data="M 3,3 L 9,9 M 9,3 L 3,9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="12" Height="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>

                    <StackPanel x:Name="SubView" Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DoneDateText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="10,0,4,0" ToolTip="Bu alt iş bu gün bitti"
                                       Visibility="{Binding HasDoneDate, Converter={StaticResource Visible}}" />
                            <TextBox x:Name="SubText" Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" FontSize="14" />
                        </DockPanel>
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Description, Mode=OneWay}" FontSize="13"
                                 Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2"
                                 Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <StackPanel x:Name="SubEdit" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                                IsVisibleChanged="EditPanel_IsVisibleChanged">
                        <TextBox Style="{StaticResource InputBox}" FontSize="13.5" Padding="10,6"
                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Enter: kaydet, Ctrl+Enter: kaydet ve tikle, Alt+Enter: alt satır, Esc: vazgeç"
                                 PreviewKeyDown="SubEditBox_PreviewKeyDown" AutomationProperties.Name="Alt işi düzenle" />
                    </StackPanel>

                </Grid>
                </Border>
            </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="SubRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="SubRow" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsInDetail}" Value="True">
                    <Setter TargetName="SubRow" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="SubText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStruck}" Value="True">
                    <Setter TargetName="SubText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="SubText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="SubView" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SubEdit" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFoldedAway}" Value="True">
                    <Setter TargetName="Item" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFoldHidden}" Value="True">
                    <Setter TargetName="Item" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="SubRow" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="SubRow" Property="Background" Value="{DynamicResource KeyRowBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EntryTemplate">
            <!-- The padding replaces the gap between rows, so the pointer is always over exactly one of them. -->
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Margin="-22,0,-6,0" Padding="0,6,5,6" BorderThickness="1" BorderBrush="Transparent"
                    Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False"
                    PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Row_MouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="4" Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="22,-8,0,0"
                        IsHitTestVisible="False" Visibility="{Binding ShowDropAbove, Converter={StaticResource Visible}}" />
                <Border Grid.ColumnSpan="4" Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="22,0,0,-8"
                        IsHitTestVisible="False" Visibility="{Binding ShowDropBelow, Converter={StaticResource Visible}}" />

                <!-- The keyboard's task: an accent bar at the left edge -->
                <Border x:Name="KeyBar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,2,0,2" Background="{DynamicResource AccentBrush}"
                        Visibility="Collapsed" IsHitTestVisible="False" />
                <Button x:Name="Grip" Style="{StaticResource IconButton}" Content="{StaticResource IconGrip}" Padding="0,2" Margin="0,0,0,0"
                        VerticalAlignment="Top" Opacity="0.3" Cursor="SizeAll" Click="Grip_Click"
                        PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown" PreviewMouseMove="Grip_PreviewMouseMove"
                        ToolTip="Sürükle: taşı. Tıkla: menü. Ctrl+tık: seç" AutomationProperties.Name="Taşıma menüsü" />

                <CheckBox x:Name="RowCheck" Grid.Column="1" Style="{StaticResource StatusCheck}" VerticalAlignment="Top" Margin="0,2,0,0"
                          IsChecked="{Binding CheckState}"
                          AutomationProperties.Name="{Binding Text}">
                    <CheckBox.Visibility>
                        <Binding Path="HasNoCheck" Converter="{StaticResource Hidden}" />
                    </CheckBox.Visibility>
                </CheckBox>
                <!-- Given up: a cross where the box was -->
                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource MutedBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" Opacity="0.7"
                        ToolTip="Bu iş iptal edildi. Geri almak için işe tıkla, panelde İptali geri al düğmesine bas."
                        Visibility="{Binding IsDropped, Converter={StaticResource Visible}}">
                    <Path Data="M 4,4 L 10,10 M 10,4 L 4,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Border>

                <StackPanel Grid.Column="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel>
                        <!-- The count of finished sub-tasks with an arrow: a click folds the sub-tasks away or opens them -->
                        <Button x:Name="BodyToggle" DockPanel.Dock="Right" Command="{Binding ToggleBodyCommand}" Cursor="Hand" Margin="8,-1,0,0" VerticalAlignment="Top"
                                FocusVisualStyle="{StaticResource FocusRing}" ToolTip="{Binding BodyToggleTip}" AutomationProperties.Name="{Binding BodyToggleTip}"
                                Visibility="{Binding HasBody, Converter={StaticResource Visible}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="4,2,2,2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Progress}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"
                                           Visibility="{Binding HasProgress, Converter={StaticResource Visible}}" />
                                <!-- A task with only a description: a note sign where the count would be -->
                                <Path Data="M 3,4.5 L 13,4.5 M 3,8 L 13,8 M 3,11.5 L 9.5,11.5" Width="16" Height="16" Margin="0,0,2,0" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                      Visibility="{Binding IsNoteOnly, Converter={StaticResource Visible}}" />
                                <Path Width="16" Height="16" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconDown}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconRight}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Origin}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   Margin="10,1,0,0" Visibility="{Binding HasOrigin, Converter={StaticResource Visible}}"
                                   ToolTip="Bu işin yazıldığı gün" />
                        <ContentControl DockPanel.Dock="Right" Content="{Binding Chip}" Style="{StaticResource TimeChipHost}"
                                        Margin="10,2,0,0" VerticalAlignment="Top" />
                        <TextBox Text="{Binding Text, Mode=OneWay}" FontSize="15" ContextMenu="{x:Null}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropped}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding BodyItems}" Focusable="False" Margin="0,6,0,0"
                                  ItemTemplate="{StaticResource BodyItemTemplate}"
                                  Visibility="{Binding ShowBody, Converter={StaticResource Visible}}" />

                    <Grid Margin="0,6,0,0" Visibility="{Binding IsAddingSubTask, Converter={StaticResource Visible}}"
                          IsVisibleChanged="SubTaskPanel_IsVisibleChanged">
                        <TextBox x:Name="SubTaskBox" Style="{StaticResource InputBox}" FontSize="13.5" Padding="10,6"
                                 Text="{Binding SubTaskDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Loaded="SubTaskBox_Loaded"
                                 PreviewKeyDown="SubTaskBox_PreviewKeyDown" AutomationProperties.Name="Alt iş yaz" />
                        <TextBlock x:Name="SubTaskHint" Text="Alt iş yaz. Enter: ekle, Ctrl+Enter: tikli ekle, Alt+Enter: açıklama, Esc: kapat" FontSize="13.5" Margin="13,7,0,0"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>

                </StackPanel>

                <StackPanel Grid.Column="2" Grid.ColumnSpan="2"
                            Visibility="{Binding IsEditing, Converter={StaticResource Visible}}"
                            IsVisibleChanged="EditPanel_IsVisibleChanged">
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MaxHeight="320"
                             ToolTip="İlk satır başlık, altındakiler açıklama, - ile başlayan satır alt iş. Enter: kaydet, Ctrl+Enter: kaydet ve tikle, Alt+Enter: alt satır, Esc: vazgeç"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="EditBox_PreviewKeyDown"
                             Visibility="{Binding DataContext.IsTextWriting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="Notu düzenle" />
                    <!-- The same text in the visual box: a box before the title, notes in grey, sub-tasks with their own box -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7"
                            Visibility="{Binding DataContext.IsVisualWriting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"
                            ToolTip="Shift+Enter: alt satır, - ile başlarsan alt iş. Enter: kaydet, Ctrl+Enter: kaydet ve tikle, Esc: vazgeç">
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <local:TaskLinesEditor Text="{Binding EditText}" DoneSubTasks="{Binding DoneSubTasks}"
                                                   Loaded="EditEditor_Loaded" AutomationProperties.Name="Notu düzenle" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveCommand}" ToolTip="Enter" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" Command="{Binding CancelCommand}" Margin="8,0,0,0" ToolTip="Esc" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RowActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-4,0,0">
                <Button x:Name="BringButton" Style="{StaticResource LinkButton}" Content="Bugüne al" Command="{Binding BringToTodayCommand}" VerticalAlignment="Center"
                        ToolTip="Bu işi bugünün listesine taşır" AutomationProperties.Name="Bugüne al"
                        Visibility="{Binding CanBringToToday, Converter={StaticResource Visible}}" />
                <StackPanel x:Name="Actions" Orientation="Horizontal" Opacity="0.3">
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconEdit}" Command="{Binding EditCommand}"
                            ToolTip="Düzenle" AutomationProperties.Name="Düzenle" />
                </StackPanel>
                </StackPanel>
            </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}" />
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInDetail}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsJustAdded}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <Trigger SourceName="Grip" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="Actions" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="RowActions" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=SubTaskBox}" Value="">
                    <Setter TargetName="SubTaskHint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Tab walks the tasks: the one reached is framed; F2 edits it in place, Enter opens it on the right -->
                <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource KeyRowBrush}" />
                    <Setter TargetName="KeyBar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="MonthPanel">
            <UniformGrid Columns="7" Rows="6" />
        </ItemsPanelTemplate>

        <!-- Small calendar in the sidebar: green deepens with finished work, the dot means open work. -->
        <Style x:Key="MiniDay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="5" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                                <TextBlock x:Name="Number" Text="{Binding Day}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkBrush}" />
                            </Border>
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource OpenBrush}" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="1">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat1Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="2">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat2Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="3">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat3Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasOpen}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ThumbBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InMonth}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Dot" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPickCursor}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="3" />
                                <Setter TargetName="Root" Property="Opacity" Value="1" />
                                <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="1" />
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full month: the same colour language, plus what was actually written that day. -->
        <Style x:Key="MonthDay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource CalendarDayBrush}" BorderThickness="2"
                                BorderBrush="Transparent" Padding="7,5" ClipToBounds="True">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="Number" DockPanel.Dock="Top" Text="{Binding Day}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" Margin="0,0,0,3" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding More}" FontSize="12" Foreground="{DynamicResource InkBrush}"
                                           Visibility="{Binding HasMore, Converter={StaticResource Visible}}" />
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" ClipToBounds="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,1">
                                                <Ellipse x:Name="LineDot" DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,4,0"
                                                         Fill="{DynamicResource OpenBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                                <TextBlock x:Name="LineText" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter TargetName="LineDot" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="1">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat1Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="2">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat2Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="3">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat3Brush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ThumbBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InMonth}" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Week, month, year switch on the calendar page; Tag marks the one shown -->
        <Style x:Key="ScaleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="5" Background="Transparent" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One day of the week page: date on the left, the work written out on the right -->
        <Style x:Key="WeekCard" TargetType="Button">
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WeekDay_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="WeekDay_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="WeekDay_PreviewMouseLeftButtonUp" />
            <EventSetter Event="DragOver" Handler="WeekDay_DragOver" />
            <EventSetter Event="DragLeave" Handler="WeekDay_DragLeave" />
            <EventSetter Event="Drop" Handler="WeekDay_Drop" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource CalendarDayBrush}" BorderThickness="1.5" BorderBrush="Transparent"
                                Padding="8,10,14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Name="DayNumber" Text="{Binding Day}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock x:Name="DayName" Text="{Binding DayName}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel x:Name="Line" Margin="0,2" Background="Transparent" Cursor="SizeAll">
                                                    <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Margin="0,1,10,1" Background="{DynamicResource DoneBrush}" />
                                                    <ContentControl DockPanel.Dock="Right" Content="{Binding Chip}" Style="{StaticResource TimeChipHost}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                                    <TextBlock x:Name="LineText" Text="{Binding Text}" ToolTip="{Binding Text}" ToolTipService.Placement="Bottom" ToolTipService.ShowDuration="30000" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               LineStackingStrategy="BlockLineHeight" LineHeight="19" MaxHeight="38" Foreground="{DynamicResource InkBrush}" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource OpenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPartlyDone}" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PartialBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropped}" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ThumbBrush}" />
                                                        <Setter TargetName="LineText" Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInDetail}" Value="True">
                                                        <Setter TargetName="Line" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                        <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="Nothing" Text="Görev eklenmedi" FontSize="14" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                                <Setter TargetName="DayName" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasWork}" Value="False">
                                <Setter TargetName="Nothing" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ThumbBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One day of the week page, as a column: the date on top, the work written out under it -->
        <Style x:Key="WeekColumn" TargetType="Button">
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WeekDay_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="WeekDay_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="WeekDay_PreviewMouseLeftButtonUp" />
            <EventSetter Event="DragOver" Handler="WeekDay_DragOver" />
            <EventSetter Event="DragLeave" Handler="WeekDay_DragLeave" />
            <EventSetter Event="Drop" Handler="WeekDay_Drop" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource CalendarDayBrush}" BorderThickness="1.5" BorderBrush="Transparent">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                                    <TextBlock x:Name="DayName" Text="{Binding DayName}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <Border x:Name="Badge" CornerRadius="15" Width="34" Height="30" Margin="0,2,0,0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DayNumber" Text="{Binding Day}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                    </Border>
                                </StackPanel>
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource InputBorderBrush}" Margin="8,0,8,6" Opacity="0.6" />
                                <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <StackPanel Margin="8,2,8,10">
                                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel x:Name="Line" Margin="0,3" Background="Transparent" Cursor="SizeAll">
                                                        <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Margin="0,1,7,1" Background="{DynamicResource DoneBrush}" />
                                                        <!-- Narrow column: the time alone, no label -->
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Chip.Text}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" Margin="4,1,0,0" VerticalAlignment="Top" />
                                                        <TextBlock x:Name="LineText" Text="{Binding Text}" ToolTip="{Binding Text}" ToolTipService.Placement="Bottom" ToolTipService.ShowDuration="30000" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="51" Foreground="{DynamicResource InkBrush}" />
                                                    </DockPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource OpenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPartlyDone}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PartialBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDropped}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ThumbBrush}" />
                                                            <Setter TargetName="LineText" Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInDetail}" Value="True">
                                                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="Nothing" Text="Görev eklenmedi" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                                <Setter TargetName="DayName" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasWork}" Value="False">
                                <Setter TargetName="Nothing" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ThumbBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A day square on the year page -->
        <Style x:Key="YearDay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <!-- Set from the window's size (YearScroll_SizeChanged): as square as the year still fits without scrolling. -->
            <Setter Property="Height" Value="{DynamicResource YearDayHeight}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="3" Background="{DynamicResource InputBrush}" BorderThickness="1.5" BorderBrush="Transparent">
                            <TextBlock x:Name="Number" Text="{Binding Day}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource WeekendBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="1">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat1Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="2">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat2Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HeatLevel}" Value="3">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Heat3Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasOpen}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource OpenBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ThumbBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="YearLetter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WeekdayLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- First-run choices: a whole card to press; the radio kind stays outlined while chosen -->
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{DynamicResource CellBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{DynamicResource CellBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Width" Value="36" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="QuietLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>

        <!-- The add box's title line: no frame of its own, the box around it is the frame. -->
        <Style x:Key="ComposerTitleBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="150" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A description or sub-task line inside the add box -->
        <Style x:Key="ComposerFieldBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A file and a group heading in the files list, in the new list and the classic sidebar alike -->
        <DataTemplate DataType="{x:Type local:FileRow}">
            <Grid x:Name="FileRow" Margin="0,0,0,2" Background="Transparent" MouseRightButtonUp="FileRow_MouseRightButtonUp">
                <Button Style="{StaticResource NavButton}" Command="{Binding SelectCommand}" Tag="{Binding IsCurrent}"
                        FontSize="13.5" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                    <DockPanel>
                        <TextBlock x:Name="Note" DockPanel.Dock="Right" Text="{Binding Note}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenBrush}" Margin="8,0,52,0"
                                   ToolTip="Bu dosyadaki bitmemiş işlerin tamamı, bugünküler dahil" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <StackPanel x:Name="RowButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Opacity="0">
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconGrip}" Padding="5" Click="FileMenu_Click"
                            ToolTip="Yeniden adlandır, gruba taşı" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} dosya menüsü'}" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="5"
                            Command="{Binding RemoveCommand}" ToolTip="{Binding RemoveTip}"
                            AutomationProperties.Name="{Binding RemoveTip}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                    <Setter TargetName="FileRow" Property="Margin" Value="14,0,0,2" />
                </DataTrigger>
                <Trigger SourceName="FileRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowButtons" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="RowButtons" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="RowButtons" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FileGroupRow}">
            <Grid x:Name="GroupRow" Margin="0,0,0,2" Background="Transparent">
                <Button Style="{StaticResource NavButton}" Command="{Binding ToggleCommand}" Tag="{Binding HidesCurrent}"
                        FontSize="13.5" ToolTip="Grubu aç veya kapat" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} grubu'}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenBrush}" Margin="8,0,52,0"
                                   ToolTip="Gruptaki dosyalarda bitmemiş işlerin toplamı" />
                        <Path x:Name="Chevron" Data="{StaticResource IconDown}" Width="16" Height="16" Margin="-2,0,4,0" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <StackPanel x:Name="RowButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Opacity="0">
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconEdit}" Padding="5" Command="{Binding RenameCommand}"
                            ToolTip="Yeniden adlandır" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} grubunu yeniden adlandır'}" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="5" Command="{Binding DeleteCommand}"
                            ToolTip="Grubu kaldır (dosyalar listede kalır)" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} grubunu kaldır'}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="{StaticResource IconRight}" />
                </DataTrigger>
                <Trigger SourceName="GroupRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowButtons" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="RowButtons" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="RowButtons" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid x:Name="MainGrid" SizeChanged="MainGrid_SizeChanged">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFile}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: a strip of sections, and beside it the chosen section's list -->
            <Border x:Name="Rail" Width="60" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClassicSidebar}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="0,12,0,10">
                    <Viewbox DockPanel.Dock="Top" Width="22" Height="22" Margin="0,2,0,14" ToolTip="İş Günlüğü">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="18" RadiusX="4" RadiusY="4" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="6.5" Canvas.Top="1" Width="2.6" Height="6" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="14.9" Canvas.Top="1" Width="2.6" Height="6" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource AccentBrush}" />
                            <Path Data="M 7,13.5 L 10.5,17 L 17,10" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Width="54" Content="{StaticResource IconSettings}"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar" />
                    <StackPanel>
                        <Grid>
                            <Button x:Name="TasksRail" Style="{StaticResource RailButton}" Width="54" Content="{StaticResource IconTasks}"
                                    Command="{Binding ShowSectionCommand}" CommandParameter="tasks" Tag="{Binding IsTasksSection}"
                                    AllowDrop="True" DragEnter="Rail_DragOver" DragOver="Rail_DragOver"
                                    ToolTip="Bugün, Tamamlanmamış, Gelecek, Tarihsiz, Tümü (Ctrl+1…5)" AutomationProperties.Name="İşler" />
                            <!-- Work left over from past days, in sight from every section -->
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource OpenBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,13,0"
                                     IsHitTestVisible="False"
                                     Visibility="{Binding HasOverdueWork, Converter={StaticResource Visible}}" />
                        </Grid>
                        <Button x:Name="CalendarRail" Style="{StaticResource RailButton}" Width="54" Content="{StaticResource IconCalendar}"
                                Command="{Binding ShowSectionCommand}" CommandParameter="calendar" Tag="{Binding IsCalendarSection}"
                                AllowDrop="True" DragEnter="Rail_DragOver" DragOver="Rail_DragOver"
                                ToolTip="Büyük takvim: hafta, ay, yıl (Ctrl+6)" AutomationProperties.Name="Takvim" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Beside the strip; on a narrow window it lies over the middle while a section is open -->
            <Border x:Name="SectionPane" Width="244" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                    ButtonBase.Click="SectionPane_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRailOnly}" Value="True">
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Panel.ZIndex" Value="30" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRailOnly}" Value="True" />
                                    <Condition Binding="{Binding IsSectionOverlayOpen}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsClassicSidebar}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Resources>
                    <Style x:Key="NavIcon" TargetType="Path">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="16" />
                        <Setter Property="Margin" Value="0,0,10,0" />
                        <Setter Property="StrokeThickness" Value="1.3" />
                        <Setter Property="StrokeStartLineCap" Value="Round" />
                        <Setter Property="StrokeEndLineCap" Value="Round" />
                        <Setter Property="StrokeLineJoin" Value="Round" />
                        <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="SectionTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                        <Setter Property="Margin" Value="10,10,0,6" />
                    </Style>
                </Border.Resources>
                <Grid>
                <DockPanel>
                    <!-- The open file: a press lists every file, to switch to one, sort and rename them -->
                    <Button x:Name="FilePickerButton" DockPanel.Dock="Top" Style="{StaticResource FilePickerButton}" Margin="12,14,12,8"
                            Command="{Binding ToggleFilePickerCommand}" Tag="{Binding IsFilePickerOpen}"
                            ToolTip="Başka dosyaya geç, dosyaları sırala ve düzenle"
                            AutomationProperties.Name="{Binding CurrentFileTitle, StringFormat='Dosya: {0}'}">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Width="16" Height="16" Margin="6,0,0,0" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconDown}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilePickerOpen}" Value="True">
                                                <Setter Property="Data" Value="M 3,10 L 8,5 L 13,10" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding AllCount}" FontWeight="Normal" ToolTip="Bu dosyadaki bitmemiş işler">
                                <ContentControl.Tag>
                                    <sys:Boolean>True</sys:Boolean>
                                </ContentControl.Tag>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl" BasedOn="{StaticResource CountBadge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconFiles}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CurrentFileTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <!-- In every section, the same place: search first, the user wants it always there -->
                    <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" FontSize="13.5" Padding="30,7,10,7"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Notlarda ara (Ctrl+F)" AutomationProperties.Name="Notlarda ara" />
                        <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="9,0,0,0" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left"
                              Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Notlarda ara" FontSize="13.5" Margin="33,0,0,0" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="NewTaskButton" DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" Margin="12,0,12,10" Padding="12,8"
                            HorizontalAlignment="Stretch" Command="{Binding NewTaskCommand}" ToolTip="Alttaki kutuya yeni iş yaz (Ctrl+N)"
                            AutomationProperties.Name="Yeni iş">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Width="16" Height="16" Margin="0,0,7,0" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stroke="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Yeni iş" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid>
                        <!-- İşler -->
                        <ScrollViewer x:Name="TasksList" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsTasksSection, Converter={StaticResource Visible}}">
                            <StackPanel Margin="8,0,8,12">
                                <Button x:Name="TodayNav" Style="{StaticResource NavItem}" Command="{Binding ShowTodayCommand}"
                                        Tag="{Binding IsTodayView}" Margin="0,0,0,2" AllowDrop="True"
                                        DragOver="TodayNav_DragOver" Drop="TodayNav_Drop"
                                        ToolTip="Bugünün işleri (Ctrl+1). Bir işi buraya sürükleyince bugüne alınır."
                                        AutomationProperties.Name="Bugün">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Content="{Binding DayProgressText}" ToolTip="{Binding DayProgressName}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource CountBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DayProgressText}" Value="0/0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSun}" />
                                        <TextBlock Text="Bugün" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Button x:Name="OpenNav" Style="{StaticResource NavItem}" Command="{Binding ShowOpenCommand}"
                                        Tag="{Binding IsOpenView}" Margin="0,0,0,2"
                                        ToolTip="Önceki günlerden kalan, bitmemiş işler (Ctrl+2)"
                                        AutomationProperties.Name="Tamamlanmamış">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Content="{Binding OpenCount}">
                                            <ContentControl.Tag>
                                                <sys:Boolean>True</sys:Boolean>
                                            </ContentControl.Tag>
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource CountBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OpenCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <Path Style="{StaticResource NavIcon}" Data="M 8,2.5 A 5.5,5.5 0 1 1 8,13.5 A 5.5,5.5 0 1 1 8,2.5 M 8,5.2 L 8,8.6 M 8,10.8 L 8,10.9" />
                                        <TextBlock Text="Tamamlanmamış" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                                <Button x:Name="FutureNav" Style="{StaticResource NavItem}" Command="{Binding ShowFutureCommand}"
                                        Tag="{Binding IsFutureView}" Margin="0,0,0,2" AllowDrop="True"
                                        DragOver="TodayNav_DragOver" Drop="FutureNav_Drop"
                                        ToolTip="İleri tarihli işler (Ctrl+3). Bir işi buraya sürükleyince yarına taşınır."
                                        AutomationProperties.Name="Gelecek">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Content="{Binding FutureCount}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource CountBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FutureCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconArrowRight}" />
                                        <TextBlock Text="Gelecek" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Button x:Name="UndatedNav" Style="{StaticResource NavItem}" Command="{Binding ShowUndatedCommand}"
                                        Tag="{Binding IsUndatedView}" Margin="0,0,0,2" AllowDrop="True"
                                        DragOver="TodayNav_DragOver" Drop="UndatedNav_Drop"
                                        ToolTip="Günü belli olmayan işler (Ctrl+4). Bir işi buraya sürükleyince tarihsiz olur."
                                        AutomationProperties.Name="Tarihsiz">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Right" Content="{Binding UndatedCount}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource CountBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UndatedCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconUndated}" />
                                        <TextBlock Text="Tarihsiz" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Button x:Name="AllNav" Style="{StaticResource NavItem}" Command="{Binding ShowAllCommand}"
                                        Tag="{Binding IsAllView}" Margin="0,0,0,2"
                                        ToolTip="Bitmemiş bütün işler bir arada (Ctrl+5)"
                                        AutomationProperties.Name="Tümü">
                                    <DockPanel>
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconAll}" />
                                        <TextBlock Text="Tümü" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>

                                <!-- The small calendar stays under the lists: a task is dragged onto a day in one move.
                                     The month name opens the twelve months, to jump far. -->
                                <StackPanel Margin="4,16,4,0">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" FontSize="11"
                                                Command="{Binding NextMonthCommand}" ToolTip="İleri" AutomationProperties.Name="İleri" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" FontSize="11"
                                                Command="{Binding PreviousMonthCommand}" ToolTip="Geri" AutomationProperties.Name="Geri" />
                                        <Button x:Name="MonthHeaderButton" Style="{StaticResource MonthHeaderButton}" HorizontalAlignment="Left"
                                                Content="{Binding MiniHeaderText}" Command="{Binding ToggleMiniYearCommand}" Tag="{Binding IsMiniYearOpen}"
                                                ToolTip="Ayları göster: başka aya hızlıca geç" AutomationProperties.Name="Ayları göster" />
                                    </DockPanel>
                                    <Grid>
                                        <StackPanel Visibility="{Binding IsMiniYearOpen, Converter={StaticResource Hidden}}">
                                            <UniformGrid Columns="7" Rows="1">
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pt" />
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Sa" />
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Ça" />
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pe" />
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Cu" />
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Ct" Foreground="{DynamicResource WeekendBrush}" />
                                                <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pz" Foreground="{DynamicResource WeekendBrush}" />
                                            </UniformGrid>
                                            <ItemsControl x:Name="MiniCalendar" ItemsSource="{Binding MonthCells}" ItemsPanel="{StaticResource MonthPanel}" Focusable="False"
                                                          AllowDrop="True" DragOver="MiniCalendar_DragOver" DragLeave="MiniCalendar_DragLeave" Drop="MiniCalendar_Drop"
                                                          AutomationProperties.Name="Küçük takvim">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource MiniDay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <ItemsControl x:Name="MiniMonths" ItemsSource="{Binding MiniMonths}" Focusable="False" VerticalAlignment="Top"
                                                      Visibility="{Binding IsMiniYearOpen, Converter={StaticResource Visible}}" AutomationProperties.Name="Aylar">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MonthChipButton}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Takvim: the big calendar is the overview in the middle; here its size, the months to jump to and the period's tally -->
                        <ScrollViewer x:Name="CalendarList" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsCalendarSection, Converter={StaticResource Visible}}">
                            <StackPanel Margin="8,0,8,12">
                                <Border x:Name="PaneScaleButtons" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" Margin="4,0,4,14">
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource ScaleButton}" Content="Hafta" Command="{Binding ShowWeekScaleCommand}" Tag="{Binding IsWeekScale}"
                                                AutomationProperties.Name="Hafta görünümü" />
                                        <Button Style="{StaticResource ScaleButton}" Content="Ay" Command="{Binding ShowMonthScaleCommand}" Tag="{Binding IsMonthScale}"
                                                AutomationProperties.Name="Ay görünümü" />
                                        <Button Style="{StaticResource ScaleButton}" Content="Yıl" Command="{Binding ShowYearScaleCommand}" Tag="{Binding IsYearScale}"
                                                AutomationProperties.Name="Yıl görünümü" />
                                    </UniformGrid>
                                </Border>
                                <DockPanel Margin="4,0,4,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" FontSize="11"
                                            Command="{Binding NextPaneCommand}" ToolTip="{Binding PaneNextTip}" AutomationProperties.Name="{Binding PaneNextTip}" />
                                    <TextBlock x:Name="CalendarPaneHeaderText" DockPanel.Dock="Right" Text="{Binding CalendarPaneHeader}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="4,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" FontSize="11"
                                            Command="{Binding PreviousPaneCommand}" ToolTip="{Binding PanePreviousTip}" AutomationProperties.Name="{Binding PanePreviousTip}" />
                                    <TextBlock Text="{Binding CalendarPaneLabel}" Style="{StaticResource SectionTitle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- Weeks, months or years, by the calendar's size; one height for all three so nothing below jumps -->
                                <Grid Height="170" Margin="1,0">
                                    <DockPanel x:Name="CalendarWeeks" Visibility="{Binding IsPaneWeeks, Converter={StaticResource Visible}}">
                                        <DockPanel DockPanel.Dock="Top" Height="14" Margin="6,0,2,0">
                                            <Border Width="22" />
                                            <UniformGrid Rows="1" TextElement.FontSize="10" TextElement.Foreground="{DynamicResource MutedBrush}">
                                                <TextBlock Text="Pt" HorizontalAlignment="Center" />
                                                <TextBlock Text="Sa" HorizontalAlignment="Center" />
                                                <TextBlock Text="Ça" HorizontalAlignment="Center" />
                                                <TextBlock Text="Pe" HorizontalAlignment="Center" />
                                                <TextBlock Text="Cu" HorizontalAlignment="Center" />
                                                <TextBlock Text="Ct" HorizontalAlignment="Center" Foreground="{DynamicResource WeekendBrush}" />
                                                <TextBlock Text="Pz" HorizontalAlignment="Center" Foreground="{DynamicResource WeekendBrush}" />
                                            </UniformGrid>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding CalendarPaneWeeks}" Focusable="False" AutomationProperties.Name="Haftalar">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding PickCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                            ToolTip="Ortadaki takvimi bu haftaya götür" AutomationProperties.Name="{Binding Name}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <!-- As the month and year chips: the week is a white strip on the grey, its number stays outside on the grey. -->
                                                                <Border x:Name="Root" Background="Transparent" Padding="4,2,2,2">
                                                                    <DockPanel>
                                                                        <TextBlock x:Name="Number" Width="22" Text="{Binding Number}" FontSize="11"
                                                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                        <Border x:Name="Strip" Background="{DynamicResource InputBrush}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Padding="0,0">
                                                                        <ItemsControl ItemsSource="{Binding Days}" Focusable="False" VerticalAlignment="Center">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <UniformGrid Rows="1" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Width="21" Height="18" HorizontalAlignment="Center">
                                                                                        <Border x:Name="Cell" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" />
                                                                                        <TextBlock x:Name="Day" Text="{Binding Day}" FontSize="11" Foreground="{DynamicResource InkBrush}"
                                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                        <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{DynamicResource OpenBrush}" HorizontalAlignment="Center"
                                                                                                 VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed" />
                                                                                    </Grid>
                                                                                    <DataTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                                            <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsOutside}" Value="True">
                                                                                            <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                                            <Setter TargetName="Day" Property="Opacity" Value="0.55" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HeatLevel}" Value="1">
                                                                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Heat1Brush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HeatLevel}" Value="2">
                                                                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Heat2Brush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HeatLevel}" Value="3">
                                                                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Heat3Brush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                            <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                            <Setter TargetName="Day" Property="FontWeight" Value="SemiBold" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasOpen}" Value="True">
                                                                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        </Border>
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Strip" Property="BorderBrush" Value="{DynamicResource ThumbBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsShown}" Value="True">
                                                                        <Setter TargetName="Strip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter TargetName="Strip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <ItemsControl x:Name="CalendarMonths" ItemsSource="{Binding CalendarPaneMonths}" Focusable="False"
                                                  AutomationProperties.Name="Aylar" Visibility="{Binding IsPaneMonths, Converter={StaticResource Visible}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" Rows="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MonthChipButton}" ToolTip="Ortadaki takvimi bu aya götür" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="CalendarYears" ItemsSource="{Binding CalendarPaneYears}" Focusable="False"
                                                  AutomationProperties.Name="Yıllar" Visibility="{Binding IsPaneYears, Converter={StaticResource Visible}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" Rows="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MonthChipButton}" FontSize="14" ToolTip="Ortadaki takvimi bu yıla götür" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="10,8" Margin="4,12,4,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CalendarPaneSummaryTitle}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CalendarPaneSummary}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BackToTodayButton" Style="{StaticResource LinkButton}" Content="Bugüne dön" HorizontalAlignment="Left" Margin="2,10,0,0"
                                        Command="{Binding ShowTodayCommand}" ToolTip="Bugünün işlerini aç" AutomationProperties.Name="Bugüne dön" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- The file picker, opened over the list under its button. Lines are dragged by their dots into order, or under
                     another group; the pencil or F2 renames in place, the dots menu and a right click hold the rest. -->
                <Border x:Name="FilesPanel" Margin="8,52,8,0" VerticalAlignment="Top" Panel.ZIndex="20" Background="{DynamicResource WindowBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,6,4,4"
                        Visibility="{Binding IsFilePickerOpen, Converter={StaticResource Visible}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.4" />
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,0,2,2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconNotepad}" FontSize="12" Padding="4"
                                    Command="{Binding OpenInEditorCommand}" ToolTip="Açık dosyayı Not Defteri'nde aç" AutomationProperties.Name="Not Defteri'nde aç" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconFolder}" FontSize="12" Padding="4"
                                    Command="{Binding OpenNotesFolderCommand}" ToolTip="Dosyaların klasörünü aç (Belgeler\İş Günlüğü)" AutomationProperties.Name="Dosyaların klasörünü aç" />
                            <TextBlock Text="DOSYALAR" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="6,6,2,2" LastChildFill="False">
                            <Button Style="{StaticResource LinkButton}" Content="＋ Yeni dosya" Command="{Binding CreateFileCommand}" Margin="0,0,8,0"
                                    ToolTip="Adını sorup İş Günlüğü klasöründe yeni bir .txt açar" AutomationProperties.Name="Yeni dosya" />
                            <Button Style="{StaticResource LinkButton}" Content="＋ Grup" Command="{Binding NewEmptyGroupCommand}" Margin="0"
                                    ToolTip="Boş bir grup açar; dosyaları sonra altına sürükle" AutomationProperties.Name="Yeni grup" />
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource InputBorderBrush}" Margin="4,4,4,0" />
                        <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="420">
                            <ItemsControl x:Name="PickerList" ItemsSource="{Binding Files}" Focusable="False" AllowDrop="True" Background="Transparent"
                                          DragOver="Picker_DragOver" DragLeave="Picker_DragLeave" Drop="Picker_Drop" AutomationProperties.Name="Dosyalar">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type local:FileRow}">
                                        <Grid x:Name="Row" Background="Transparent" MouseRightButtonUp="FileRow_MouseRightButtonUp">
                                            <DockPanel Margin="0,1">
                                                <Border DockPanel.Dock="Left" Width="16" Background="Transparent" Cursor="SizeAll"
                                                        PreviewMouseLeftButtonDown="PickerGrip_MouseDown" MouseMove="PickerGrip_MouseMove"
                                                        ToolTip="Sürükle: sırayı değiştir ya da başka bir grubun altına taşı">
                                                    <Path Data="{StaticResource IconGrip}" Width="16" Height="16" StrokeThickness="2" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" Stroke="{DynamicResource MutedBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                                                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconEdit}" Padding="4" Click="PickerRename_Click"
                                                            ToolTip="Yeniden adlandır (F2)" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} yeniden adlandır'}" />
                                                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IconMore}" Padding="4" Click="FileMenu_Click"
                                                            ToolTip="Gruba taşı, Not Defteri'nde aç, sil" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} dosya menüsü'}" />
                                                </StackPanel>
                                                <Grid>
                                                    <Button x:Name="Pick" Style="{StaticResource NavItem}" Command="{Binding SelectCommand}" Tag="{Binding IsCurrent}"
                                                            FontSize="13.5" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}"
                                                            Visibility="{Binding IsRenaming, Converter={StaticResource Hidden}}">
                                                        <DockPanel>
                                                            <ContentControl x:Name="Note" DockPanel.Dock="Right" Content="{Binding Note}" Margin="6,0,0,0"
                                                                            ToolTip="Bu dosyadaki bitmemiş işler">
                                                                <ContentControl.Tag>
                                                                    <sys:Boolean>True</sys:Boolean>
                                                                </ContentControl.Tag>
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource CountBadge}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Note}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Button>
                                                    <TextBox x:Name="RenameBox" Style="{StaticResource InputBox}" FontSize="13.5" Padding="6,4"
                                                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                                                             PreviewKeyDown="PickerRenameBox_PreviewKeyDown" LostKeyboardFocus="PickerRenameBox_LostKeyboardFocus"
                                                             IsVisibleChanged="PickerRenameBox_IsVisibleChanged" AutomationProperties.Name="Yeni ad" />
                                                </Grid>
                                            </DockPanel>
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="16,-1,0,0"
                                                    IsHitTestVisible="False" Visibility="{Binding ShowDropAbove, Converter={StaticResource Visible}}" />
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="16,0,0,-1"
                                                    IsHitTestVisible="False" Visibility="{Binding ShowDropBelow, Converter={StaticResource Visible}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                                <Setter TargetName="Row" Property="Margin" Value="12,0,0,0" />
                                            </DataTrigger>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger SourceName="Actions" Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type local:FileGroupRow}">
                                        <Grid x:Name="Row" Background="Transparent" Margin="0,4,0,0">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="16" Background="Transparent" Cursor="SizeAll"
                                                            PreviewMouseLeftButtonDown="PickerGrip_MouseDown" MouseMove="PickerGrip_MouseMove"
                                                            ToolTip="Sürükle: grubun sırasını değiştir">
                                                        <Path Data="{StaticResource IconGrip}" Width="16" Height="16" StrokeThickness="2" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" Stroke="{DynamicResource MutedBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconEdit}" Padding="4" Click="PickerRename_Click"
                                                                ToolTip="Grubu yeniden adlandır (F2)" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} grubunu yeniden adlandır'}" />
                                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="4" Command="{Binding DeleteCommand}"
                                                                ToolTip="Grubu kaldır (dosyalar listede kalır)" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} grubunu kaldır'}" />
                                                    </StackPanel>
                                                    <Grid>
                                                        <Button Style="{StaticResource NavItem}" Command="{Binding ToggleCommand}" Tag="{Binding HidesCurrent}"
                                                                FontSize="12" ToolTip="Grubu aç veya kapat" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} grubu'}"
                                                                Visibility="{Binding IsRenaming, Converter={StaticResource Hidden}}">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource OpenBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                           ToolTip="Gruptaki dosyalarda bitmemiş işlerin toplamı" />
                                                                <Path x:Name="Chevron" Data="{StaticResource IconDown}" Width="16" Height="16" Margin="-2,0,4,0" StrokeThickness="1.5"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Button>
                                                        <TextBox Style="{StaticResource InputBox}" FontSize="13" Padding="6,4"
                                                                 Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                                                                 PreviewKeyDown="PickerRenameBox_PreviewKeyDown" LostKeyboardFocus="PickerRenameBox_LostKeyboardFocus"
                                                                 IsVisibleChanged="PickerRenameBox_IsVisibleChanged" AutomationProperties.Name="Grubun yeni adı" />
                                                    </Grid>
                                                </DockPanel>
                                                <TextBlock x:Name="EmptyHint" Text="Dosyayı tutup buraya sürükle" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                           Margin="34,2,0,4" Visibility="Collapsed" />
                                            </StackPanel>
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="16,-1,0,0"
                                                    IsHitTestVisible="False" Visibility="{Binding ShowDropAbove, Converter={StaticResource Visible}}" />
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="16,0,0,-1"
                                                    IsHitTestVisible="False" Visibility="{Binding ShowDropBelow, Converter={StaticResource Visible}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter TargetName="Chevron" Property="Data" Value="{StaticResource IconRight}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger SourceName="Actions" Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>
            </Border>

<!-- The sidebar as it was, for those who choose the classic one in Settings. Same handlers, Classic names. -->
            <Grid x:Name="ClassicSidebar" Grid.ColumnSpan="2" Width="300" HorizontalAlignment="Left" Background="{DynamicResource SidebarBrush}"
                  Visibility="{Binding IsClassicSidebar, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Button x:Name="ClassicSettingsButton" Style="{StaticResource IconButton}" Content="{StaticResource IconSettings}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                        Command="{Binding ToggleSettingsCommand}" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar" />
                <StackPanel Orientation="Horizontal" Margin="20,16,48,12">
                    <Viewbox Width="22" Height="22" Margin="0,0,9,0">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="18" RadiusX="4" RadiusY="4" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="6.5" Canvas.Top="1" Width="2.6" Height="6" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="14.9" Canvas.Top="1" Width="2.6" Height="6" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource AccentBrush}" />
                            <Path Data="M 7,13.5 L 10.5,17 L 17,10" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="İş Günlüğü" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="14,0,14,10">
                    <TextBox x:Name="ClassicSearchBox" Style="{StaticResource InputBox}" FontSize="13.5" Padding="30,7,10,7"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" AutomationProperties.Name="Notlarda ara" />
                    <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="9,0,0,0" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left"
                          Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Notlarda ara" FontSize="13.5" Margin="33,0,0,0" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ClassicSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ScrollViewer x:Name="ClassicSidebarScroll" Grid.Row="2" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                <StackPanel Margin="10,0,10,14">
                    <Button x:Name="ClassicTodayNav" Style="{StaticResource NavButton}" Command="{Binding ShowTodayCommand}"
                            Tag="{Binding IsTodayView}" Margin="0,0,0,2" AllowDrop="True"
                            DragOver="TodayNav_DragOver" Drop="TodayNav_Drop"
                            ToolTip="Bugünün işleri. Bir işi buraya sürükleyince bugüne alınır."
                            AutomationProperties.Name="Bugün">
                        <TextBlock Text="Bugün" />
                    </Button>

                    <Button x:Name="ClassicTaskGroupButton" Style="{StaticResource NavButton}" Command="{Binding ToggleTaskGroupCommand}"
                            Tag="{Binding IsTaskGroupMarked}" Margin="0,0,0,2"
                            ToolTip="Grubu aç veya kapat" AutomationProperties.Name="İşler grubu">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AllCount}" Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding IsTaskGroupCollapsed, Converter={StaticResource Visible}}" />
                            <Path Width="16" Height="16" Margin="-2,0,4,0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconDown}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTaskGroupCollapsed}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconRight}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="İşler" />
                        </DockPanel>
                    </Button>

                    <StackPanel Margin="14,0,0,0" Visibility="{Binding ShowTaskGroup, Converter={StaticResource Visible}}">
                        <Button x:Name="ClassicOpenNav" Style="{StaticResource NavButton}" Command="{Binding ShowOpenCommand}"
                                Tag="{Binding IsOpenView}" Margin="0,0,0,2"
                                ToolTip="Önceki günlerden kalan, bitmemiş işler"
                                AutomationProperties.Name="Tamamlanmamış">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OpenCount}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OpenBrush}" />
                                <TextBlock Text="Tamamlanmamış" />
                            </DockPanel>
                        </Button>
                        <Button x:Name="ClassicFutureNav" Style="{StaticResource NavButton}" Command="{Binding ShowFutureCommand}"
                                Tag="{Binding IsFutureView}" Margin="0,0,0,2" AllowDrop="True"
                                DragOver="TodayNav_DragOver" Drop="FutureNav_Drop"
                                ToolTip="İleri tarihli işler. Bir işi buraya sürükleyince yarına taşınır."
                                AutomationProperties.Name="Gelecek">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FutureCount}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="Gelecek" />
                            </DockPanel>
                        </Button>
                        <Button x:Name="ClassicUndatedNav" Style="{StaticResource NavButton}" Command="{Binding ShowUndatedCommand}"
                                Tag="{Binding IsUndatedView}" Margin="0,0,0,2" AllowDrop="True"
                                DragOver="TodayNav_DragOver" Drop="UndatedNav_Drop"
                                ToolTip="Günü belli olmayan işler. Bir işi buraya sürükleyince tarihsiz olur."
                                AutomationProperties.Name="Tarihsiz">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UndatedCount}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="Tarihsiz" />
                            </DockPanel>
                        </Button>
                        <Button x:Name="ClassicAllNav" Style="{StaticResource NavButton}" Command="{Binding ShowAllCommand}"
                                Tag="{Binding IsAllView}" Margin="0,0,0,2"
                                ToolTip="Bitmemiş bütün işler bir arada"
                                AutomationProperties.Name="Tümü">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AllCount}" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="Tümü" />
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <Button x:Name="ClassicCalendarNav" Style="{StaticResource NavButton}" Command="{Binding ShowCalendarCommand}"
                            Tag="{Binding IsCalendarView}"
                            AutomationProperties.Name="Takvim">
                        <TextBlock Text="Takvim" />
                    </Button>
                </StackPanel>

                <StackPanel Margin="14,0,14,0">
                    <DockPanel Margin="6,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" FontSize="11"
                                Command="{Binding NextMonthCommand}" ToolTip="Sonraki ay" AutomationProperties.Name="Sonraki ay" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" FontSize="11"
                                Command="{Binding PreviousMonthCommand}" ToolTip="Önceki ay" AutomationProperties.Name="Önceki ay" />
                        <TextBlock Text="{Binding MonthTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="7" Rows="1">
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pt" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Sa" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Ça" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pe" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Cu" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Ct" Foreground="{DynamicResource WeekendBrush}" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pz" Foreground="{DynamicResource WeekendBrush}" />
                    </UniformGrid>
                    <ItemsControl x:Name="ClassicMiniCalendar" ItemsSource="{Binding MonthCells}" ItemsPanel="{StaticResource MonthPanel}" Focusable="False"
                                  AllowDrop="True" DragOver="MiniCalendar_DragOver" DragLeave="MiniCalendar_DragLeave" Drop="MiniCalendar_Drop"
                                  AutomationProperties.Name="Küçük takvim">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MiniDay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MonthSummary}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="6,10,0,0" />
                </StackPanel>

                <DockPanel x:Name="ClassicFilesPanel" Margin="10,12,10,10">
                    <DockPanel DockPanel.Dock="Top" Margin="10,0,4,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconPlus}" FontSize="12"
                                Command="{Binding CreateFileCommand}" ToolTip="Yeni dosya oluştur" AutomationProperties.Name="Yeni dosya oluştur" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconFolder}" FontSize="12"
                                Command="{Binding OpenNotesFolderCommand}" ToolTip="Dosyaların klasörünü aç (Belgeler\İş Günlüğü)" AutomationProperties.Name="Dosyaların klasörünü aç" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconNotepad}" FontSize="12"
                                Command="{Binding OpenInEditorCommand}" ToolTip="Açık dosyayı Not Defteri'nde aç" AutomationProperties.Name="Not Defteri'nde aç" />
                        <TextBlock Text="Dosyalar" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Files}" Focusable="False" AutomationProperties.Name="Dosyalar" />
                </DockPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Content -->
            <Grid x:Name="ContentArea" Grid.Column="2" SizeChanged="ContentArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Takes keyboard focus when Esc lets go of a box in the panel: no size, so no click lands on it, and out of the Tab order -->
                <Border x:Name="FocusRest" Width="0" Height="0" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" />

                <!-- A clicked task, on the right: the list stays in view, and another click moves the panel there.
                     When the window is too narrow for both, the panel lies over the list instead of squeezing it. -->
                <Border x:Name="DetailPanel" Grid.Column="1" Grid.RowSpan="3" Width="340" Panel.ZIndex="10" HorizontalAlignment="Right"
                        Background="{DynamicResource CellBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsDetailOpen, Converter={StaticResource Visible}}">
                    <Grid>
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource LinkButton}" Command="{Binding DetailBackCommand}" HorizontalAlignment="Left" Margin="12,12,20,0"
                                ToolTip="İşin kendisine dön" AutomationProperties.Name="Ana işe dön"
                                Visibility="{Binding HasDetailBack, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding DetailOwnerTitle, StringFormat='‹ {0}'}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxWidth="290"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="19" MaxHeight="38" />
                        </Button>
                        <DockPanel DockPanel.Dock="Top" Margin="20,8,10,2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Command="{Binding CloseDetailCommand}"
                                    ToolTip="Kapat (Esc)" AutomationProperties.Name="Paneli kapat" />
                            <TextBlock x:Name="DetailHeadingText" Text="{Binding DetailHeading}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding IsDetailMainPage, Converter={StaticResource Visible}}" />
                            <TextBlock Text="Hatırlatıcı" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsDetailTimePage, Converter={StaticResource Visible}}" />
                        </DockPanel>
                        <Border x:Name="DroppedBanner" DockPanel.Dock="Top" Margin="20,2,20,6" Padding="9,6" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource OpenSoftBrush}" BorderBrush="{DynamicResource OpenEdgeBrush}"
                                Visibility="{Binding ShowDroppedBanner, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCancel}" Width="16" Height="16" Stroke="{DynamicResource OpenBrush}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DroppedBannerText}" Foreground="{DynamicResource OpenBrush}" FontSize="13" FontWeight="SemiBold"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Kept at the bottom whatever the panel scrolls to -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0" Padding="20,10"
                                Visibility="{Binding IsDetailTimePage, Converter={StaticResource Visible}}">
                            <Button HorizontalAlignment="Left" Style="{StaticResource IconTextButton}" Tag="{StaticResource IconTrash}" Content="Hatırlatıcıyı kaldır"
                                    Command="{Binding RemoveDetailTimeCommand}" Foreground="{DynamicResource DangerBrush}"
                                    ToolTip="Saati ve hatırlatmaları kaldırır" AutomationProperties.Name="Hatırlatıcıyı kaldır" />
                        </Border>
                        <!-- Delete on the left; giving up, or taking it back, on the right in its own colour -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0" Padding="20,10"
                                Visibility="{Binding IsDetailMainPage, Converter={StaticResource Visible}}">
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconTextButton}" Tag="{StaticResource IconTrash}" Content="Sil" Command="{Binding DetailDeleteCommand}"
                                        Foreground="{DynamicResource DangerBrush}" ToolTip="Sil. Geri al ile geri gelir" AutomationProperties.Name="Sil" />
                                <Button x:Name="DetailDropButton" DockPanel.Dock="Right" Content="{Binding DetailDropText}" Command="{Binding DetailDropCommand}"
                                        ToolTip="{Binding DetailDropTip}" AutomationProperties.Name="{Binding DetailDropText}"
                                        Visibility="{Binding CanDetailDrop, Converter={StaticResource Visible}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconTextButton}">
                                            <Setter Property="Tag" Value="{StaticResource IconCancel}" />
                                            <Setter Property="Foreground" Value="{DynamicResource OpenBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource OpenEdgeBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetailDropped}" Value="True">
                                                    <Setter Property="Tag" Value="{StaticResource IconReopen}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>
                        </Border>
                        <!-- The move buttons, above delete with a line between, so the two never mix -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0" Padding="20,8,20,10"
                                Visibility="{Binding IsDetailTaskPage, Converter={StaticResource Visible}}">
                            <StackPanel x:Name="DetailMoveSection">
                                <TextBlock Text="TAŞI" Style="{StaticResource DetailLabel}" Margin="0,0,0,6" />
                                <UniformGrid Columns="2" Margin="-3">
                                            <!-- One size for all four, so the longest, Takvimden seç…, fits whole at the panel's width -->
                                            <UniformGrid.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconTextButton}">
                                                    <Setter Property="FontSize" Value="12.5" />
                                                    <Setter Property="Padding" Value="6,6" />
                                                    <Setter Property="Margin" Value="3" />
                                                </Style>
                                            </UniformGrid.Resources>
                                            <Button Tag="{StaticResource IconSun}" Content="Bugüne al" Command="{Binding DetailTodayCommand}" IsEnabled="{Binding CanDetailToday}" />
                                            <Button Tag="{StaticResource IconArrowRight}" Content="Yarına" Command="{Binding DetailTomorrowCommand}" IsEnabled="{Binding CanDetailTomorrow}" />
                                            <Button Tag="{StaticResource IconUndated}" Content="Tarihsize al" Command="{Binding DetailUndatedCommand}" IsEnabled="{Binding CanDetailUndated}" />
                                            <Button Tag="{StaticResource IconCalendar}" Content="Takvimden seç…" Command="{Binding DetailPickDayCommand}"
                                                    ToolTip="Sonra küçük takvimde bir güne tıkla" />
                                        </UniformGrid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <Grid>
                            <!-- The time page: the time, its reminders, ready spans and a custom one -->
                            <StackPanel Margin="20,8,20,16" Visibility="{Binding IsDetailTimePage, Converter={StaticResource Visible}}">
                                <TextBlock Text="İŞİN SAATİ" Style="{StaticResource DetailLabel}" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4,4,4">
                                            <DockPanel>
                                                <Path Data="{StaticResource IconAlarm}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" Stroke="{DynamicResource AccentBrush}"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                                <TextBox x:Name="DetailTimeBox" Text="{Binding DetailTimeText, UpdateSourceTrigger=LostFocus}" FontSize="15" Margin="8,0,0,0"
                                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" MinWidth="60"
                                                         Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}"
                                                         PreviewKeyDown="DetailTimeBox_PreviewKeyDown" ToolTip="Saati yaz ya da ↑/↓ ile 5'er dakika değiştir. Enter: kaydet"
                                                         AutomationProperties.Name="İşin saati" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="{Binding DetailTimeNote}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,0"
                                                   Visibility="{Binding HasDetailTimeNote, Converter={StaticResource Visible}}" />

                                        <TextBlock Text="HATIRLAT" Style="{StaticResource DetailLabel}" Margin="0,14,0,6" />
                                        <ItemsControl x:Name="DetailReminderList" ItemsSource="{Binding DetailReminders}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6"
                                                            Padding="10,5,4,5" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="4"
                                                                    Command="{Binding RemoveCommand}" ToolTip="Bu hatırlatmayı kaldır" AutomationProperties.Name="Hatırlatmayı kaldır"
                                                                    VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Text}" FontSize="14" Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock Text="{Binding At}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Hatırlatma ekle" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,2,0,4" />
                                        <ItemsControl x:Name="DetailReminderChoices" ItemsSource="{Binding ReminderChoices}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding PickCommand}" IsEnabled="{Binding CanPick}" Cursor="Hand" Margin="0,0,5,5"
                                                            AutomationProperties.Name="{Binding Text}" Style="{StaticResource ReminderPill}" Content="{Binding Text}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="Özel…" Command="{Binding OpenCustomReminderCommand}"
                                                ToolTip="Saat ve dakika yaz: 24 saate kadar önce" AutomationProperties.Name="Özel hatırlatma" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsCustomReminderOpen, Converter={StaticResource Visible}}">
                                            <TextBox Style="{StaticResource InputBox}" Width="44" Padding="6,4" Text="{Binding CustomHours, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="CustomReminder_KeyDown" AutomationProperties.Name="Kaç saat önce" />
                                            <TextBlock Text="sa" Margin="5,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBox Style="{StaticResource InputBox}" Width="44" Padding="6,4" Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="CustomReminder_KeyDown" AutomationProperties.Name="Kaç dakika önce" />
                                            <TextBlock Text="dk önce" Margin="5,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Ekle" Command="{Binding AddCustomReminderCommand}" ToolTip="Enter" />
                                        </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="20,4,20,16" Visibility="{Binding IsDetailMainPage, Converter={StaticResource Visible}}">
                                <TextBox x:Name="DetailTitleBox" Text="{Binding DetailTitle, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                                         FontSize="15" FontWeight="SemiBold" KeyDown="DetailTitleBox_KeyDown" AutomationProperties.Name="Başlık">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetailDropped}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- When it was finished; the day is picked again in the small calendar, the task stays where it is -->
                                <StackPanel Visibility="{Binding ShowDetailTaskDoneDate, Converter={StaticResource Visible}}">
                                    <TextBlock Text="BİTTİ" Style="{StaticResource DetailLabel}" Margin="0,14,0,6" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Tarihi değiştir" Command="{Binding DetailChangeDoneDateCommand}"
                                                VerticalAlignment="Center" ToolTip="Soldaki takvimden işin bittiği günü seç. Esc vazgeçer"
                                                AutomationProperties.Name="Bitiş tarihini değiştir" />
                                        <CheckBox Style="{StaticResource StatusCheck}" IsChecked="True" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DetailDoneDateText}" FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="9,0,8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>

                                <!-- The task's time in one row; its reminders are set on the time page -->
                                <Button x:Name="DetailTimeRow" Margin="0,10,0,0" Command="{Binding OpenDetailTimeCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                        Visibility="{Binding ShowDetailTime, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding DetailTimeTitle}"
                                        ToolTip="Hatırlatıcıyı ayarla: işin saati ve ne kadar önce hatırlatılacağı">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Box" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,6,8,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Right" Data="{StaticResource IconRight}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                                              Stroke="{DynamicResource MutedBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <Path DockPanel.Dock="Left" Data="{StaticResource IconAlarm}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4"
                                              Stroke="{DynamicResource AccentBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DetailTimeTitle}" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetailTime}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DetailTimeSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                       Visibility="{Binding HasDetailTime, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <TextBlock Text="AÇIKLAMA" Style="{StaticResource DetailLabel}" Margin="0,14,0,6" />
                                <TextBox x:Name="DetailDescriptionBox" Style="{StaticResource InputBox}" Text="{Binding DetailDescription, UpdateSourceTrigger=LostFocus}"
                                         PreviewKeyDown="DetailDescriptionBox_PreviewKeyDown" ToolTip="Enter: kaydet · Alt+Enter: alt satır"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top" AutomationProperties.Name="Açıklama" />

                                <!-- A sub-task's own page: its box, the same tick as in the list -->
                                <StackPanel x:Name="DetailSubStatus" Visibility="{Binding IsDetailSubTask, Converter={StaticResource Visible}}">
                                    <TextBlock Text="DURUM" Style="{StaticResource DetailLabel}" Margin="0,14,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource StatusCheck}" IsChecked="{Binding IsDetailSubDone, Mode=OneWay}" Command="{Binding DetailSubToggleCommand}"
                                                  IsEnabled="{Binding CanDetailSubToggle}" VerticalAlignment="Center" AutomationProperties.Name="İşaretle: bitti" />
                                        <TextBlock Text="İşaretle: bitti" FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DockPanel Margin="29,4,0,0" Visibility="{Binding ShowDetailSubDoneDate, Converter={StaticResource Visible}}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Tarihi değiştir" Command="{Binding DetailChangeDoneDateCommand}"
                                                VerticalAlignment="Center" ToolTip="Soldaki takvimden alt işin bittiği günü seç. Esc vazgeçer"
                                                AutomationProperties.Name="Bitiş tarihini değiştir" />
                                        <TextBlock Text="{Binding DetailDoneDateText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel x:Name="DetailTaskParts">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetailSubTask}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding DetailSubTasksTitle}" Style="{StaticResource DetailLabel}" Margin="0,16,0,4" />
                                    <ItemsControl x:Name="DetailSubTaskList" ItemsSource="{Binding DetailSubTasks}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="SubRow" Background="Transparent" AllowDrop="True"
                                                      DragOver="DetailSubTask_DragOver" DragLeave="DetailSubTask_DragLeave" Drop="DetailSubTask_Drop">
                                                <Border Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="20,-1,0,0" IsHitTestVisible="False"
                                                        Visibility="{Binding ShowDropAbove, Converter={StaticResource Visible}}" />
                                                <Border Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="20,0,0,-1" IsHitTestVisible="False"
                                                        Visibility="{Binding ShowDropBelow, Converter={StaticResource Visible}}" />
                                                <DockPanel Margin="0,1">
                                                    <Border x:Name="SubGrip" DockPanel.Dock="Left" Width="16" Margin="-4,4,4,0" VerticalAlignment="Top" Background="Transparent"
                                                            Cursor="SizeAll" Opacity="0.3" ToolTip="Sürükle: sırasını değiştir. Başlıktayken Alt+↑ / Alt+↓ da taşır."
                                                            PreviewMouseLeftButtonDown="DetailSubGrip_PreviewMouseLeftButtonDown" PreviewMouseMove="DetailSubGrip_PreviewMouseMove">
                                                        <Path Data="{StaticResource IconGrip}" Width="16" Height="16" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Border>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="4"
                                                            Command="{Binding RemoveCommand}" ToolTip="Alt işi sil" AutomationProperties.Name="{Binding Text, StringFormat='{}{0} sil'}" />
                                                    <Button x:Name="OpenSub" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" Padding="4"
                                                            Command="{Binding OpenCommand}" ToolTip="Alt işin açıklaması" AutomationProperties.Name="{Binding Text, StringFormat='{}{0} aç'}" />
                                                    <!-- The same note sign as in the tray panel: this sub-task has a description -->
                                                    <Path DockPanel.Dock="Right" Data="{StaticResource IconNotepad}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"
                                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="4,8,2,0" ToolTip="Açıklaması var"
                                                          Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DoneDateText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Top" Margin="6,7,2,0" ToolTip="Bu alt iş bu gün bitti"
                                                               Visibility="{Binding HasDoneDate, Converter={StaticResource Visible}}" />
                                                    <Grid DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,4,0,0">
                                                        <CheckBox Style="{StaticResource StatusCheck}" IsChecked="{Binding IsDone, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                                                  AutomationProperties.Name="{Binding Text}" Visibility="{Binding IsStruck, Converter={StaticResource Hidden}}" />
                                                        <Border  Width="18" Height="18" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource MutedBrush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Opacity="0.7" ToolTip="Bu alt iş iptal edildi"
                                                                Visibility="{Binding IsStruck, Converter={StaticResource Visible}}">
                                                            <Path Data="M 3,3 L 9,9 M 9,3 L 3,9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Width="12" Height="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Border>
                                                    </Grid>
                                                    <!-- Long titles stop at three lines with "…"; clicking opens the full text for editing -->
                                                    <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBox x:Name="SubTitle" Style="{StaticResource SelectableText}" IsReadOnly="False" IsTabStop="True" Cursor="IBeam"
                                                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" FontSize="14" Padding="2,3"
                                                             TextBlock.LineStackingStrategy="BlockLineHeight" TextBlock.LineHeight="19" MaxHeight="63" Opacity="0"
                                                             VerticalAlignment="Top" KeyDown="DetailSubTitle_KeyDown" PreviewKeyDown="DetailSubTitle_PreviewKeyDown"
                                                             ToolTip="Tıkla, düzelt, Enter'a bas. Alt+↑ / Alt+↓ sırasını değiştirir"
                                                             AutomationProperties.Name="Alt iş başlığı" />
                                                    <TextBlock x:Name="SubPreview" Text="{Binding Text}" FontFamily="{StaticResource TextFont}" FontSize="14" Foreground="{DynamicResource InkBrush}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="19"
                                                               Padding="4,3" MaxHeight="63" VerticalAlignment="Top" IsHitTestVisible="False" />
                                                    </Grid>
                                                </DockPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="SubRow" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SubGrip" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="SubTitle" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Setter TargetName="SubPreview" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsStruck}" Value="True">
                                                        <Setter TargetName="SubTitle" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Setter TargetName="SubTitle" Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter TargetName="SubPreview" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Setter TargetName="SubPreview" Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                        <Setter TargetName="OpenSub" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="OpenSub" Property="ToolTip" Value="Alt işin açıklaması var" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="SubTitle" Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="SubTitle" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        <Setter TargetName="SubTitle" Property="Opacity" Value="1" />
                                                        <Setter TargetName="SubTitle" Property="MaxHeight" Value="Infinity" />
                                                        <Setter TargetName="SubPreview" Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- The hint sits inside the empty box, so the box itself says what it is for -->
                                    <Grid Margin="0,6,0,0">
                                        <TextBox x:Name="DetailSubTaskBox" Style="{StaticResource InputBox}" KeyDown="DetailSubTaskBox_KeyDown"
                                                 ToolTip="Yeni alt işi yaz, Enter'a bas; Esc bırakır. Başlığa tıklayıp düzeltebilirsin, › açıklamasını açar, soldaki noktalarla sürükleyip sırasını değiştirirsin."
                                                 AutomationProperties.Name="Yeni alt iş" />
                                        <TextBlock Text="＋ Alt iş ekle" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=DetailSubTaskBox}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                </StackPanel>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                    <!-- The left edge: drag to widen or narrow the panel, double-click for the usual width. -->
                    <Thumb x:Name="DetailResizer" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Focusable="False"
                           DragDelta="DetailResizer_DragDelta" DragCompleted="DetailResizer_DragCompleted" MouseDoubleClick="DetailResizer_MouseDoubleClick"
                           ToolTip="Sürükleyerek genişlet, çift tıkla eski boyuna dön">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Border x:Name="Mark" Width="2" HorizontalAlignment="Left" Background="Transparent" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    </Grid>
                </Border>

                <DockPanel x:Name="Header" Margin="36,24,36,16">
                    <!-- Only the strip is left on a narrow window, so search moves up here: it is never out of reach -->
                    <Grid DockPanel.Dock="Top" MaxWidth="420" HorizontalAlignment="Left" Margin="0,-8,0,14"
                          Visibility="{Binding IsRailOnly, Converter={StaticResource Visible}}">
                        <TextBox x:Name="RailSearchBox" Style="{StaticResource InputBox}" FontSize="13.5" Padding="30,7,10,7" Width="420"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Notlarda ara (Ctrl+F)" AutomationProperties.Name="Notlarda ara" />
                        <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="9,0,0,0" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left"
                              Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Notlarda ara" FontSize="13.5" Margin="33,0,0,0" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=RailSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Hepsini bugüne al" VerticalAlignment="Top"
                            Command="{Binding BringAllToTodayCommand}" ToolTip="Önceki günlerden kalan bütün işleri bugünün listesine taşır"
                            Visibility="{Binding ShowBringAll, Converter={StaticResource Visible}}" />
                    <!-- A part of the tour waiting for this screen: one press starts it, the cross passes it -->
                    <Border x:Name="TourInvite" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,0,12,0" CornerRadius="14"
                            Background="{DynamicResource KeyRowBrush}" Visibility="{Binding HasTourInvite, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Click="TourInvite_Click" Padding="12,5,4,5" ToolTip="Bu bölümü birkaç adımda anlatır"
                                    AutomationProperties.Name="{Binding TourInviteText}">
                                <TextBlock><Run Text="✦ " /><Run Text="{Binding TourInviteText, Mode=OneWay}" /></TextBlock>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="4" Margin="0,0,6,0" Click="TourDismiss_Click"
                                    ToolTip="Bu bölümün tanıtımını geç" AutomationProperties.Name="Tanıtımı geç" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SelectAllButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Hepsini seç" VerticalAlignment="Top" Margin="0,4,12,0"
                            Command="{Binding SelectAllCommand}" ToolTip="Listedeki bütün işleri seçer. Tek tek seçmek için Ctrl+tık, aralık için Shift+tık"
                            Visibility="{Binding ShowSelectAll, Converter={StaticResource Visible}}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                Visibility="{Binding HasPager, Converter={StaticResource Visible}}">
                        <Button x:Name="HeaderTodayButton" Style="{StaticResource LinkButton}" Content="Bugüne dön" Command="{Binding ShowTodayCommand}"
                                VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Bugünün işlerini aç (Ctrl+1)" AutomationProperties.Name="Bugüne dön"
                                Visibility="{Binding ShowBackToToday, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconLeft}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"
                                ToolTip="Geri (Alt+Sol)" AutomationProperties.Name="Geri" />
                        <Button Style="{StaticResource IconButton}" Content="{StaticResource IconRight}" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}"
                                ToolTip="İleri (Alt+Sağ)" AutomationProperties.Name="İleri" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,10,0"
                                Visibility="{Binding IsCalendarView, Converter={StaticResource Visible}}">
                        <Button x:Name="CopyWeekButton" Style="{StaticResource LinkButton}" Content="Özeti kopyala" Command="{Binding CopyWeekSummaryCommand}" VerticalAlignment="Center"
                                Margin="0,0,14,0" Visibility="{Binding IsWeekScale, Converter={StaticResource Visible}}"
                                ToolTip="Bu haftada biten işleri gün gün düz metin olarak panoya kopyalar: e-postaya ya da mesai notuna yapıştır" />
                        <Button Style="{StaticResource LinkButton}" Content="{Binding CalendarNowText}" Command="{Binding CalendarNowCommand}" VerticalAlignment="Center"
                                Margin="0,0,14,0" Visibility="{Binding IsCalendarAway, Converter={StaticResource Visible}}" />
                        <!-- The new sidebar's calendar list has these; the classic sidebar shows them here -->
                        <Border x:Name="HeaderScaleButtons" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2"
                                Visibility="{Binding IsClassicSidebar, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ScaleButton}" Content="Hafta" Command="{Binding ShowWeekScaleCommand}" Tag="{Binding IsWeekScale}"
                                        AutomationProperties.Name="Hafta görünümü" />
                                <Button Style="{StaticResource ScaleButton}" Content="Ay" Command="{Binding ShowMonthScaleCommand}" Tag="{Binding IsMonthScale}"
                                        AutomationProperties.Name="Ay görünümü" />
                                <Button Style="{StaticResource ScaleButton}" Content="Yıl" Command="{Binding ShowYearScaleCommand}" Tag="{Binding IsYearScale}"
                                        AutomationProperties.Name="Yıl görünümü" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="BackToCalendarButton" Style="{StaticResource LinkButton}" Content="‹ Takvime dön" HorizontalAlignment="Left"
                                Margin="-2,-6,0,2" Command="{Binding BackToCalendarCommand}" ToolTip="Aynı haftaya ya da aya geri dön"
                                Visibility="{Binding ShowBackToCalendar, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                        <!-- Today's progress, as on the phone -->
                        <DockPanel Width="280" Margin="0,2,14,2" ToolTip="{Binding DayProgressName}"
                                   AutomationProperties.Name="{Binding DayProgressName}"
                                   Visibility="{Binding HasDayProgress, Converter={StaticResource Visible}}">
                            <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding DayProgressText, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Finished in green, the finished share of tasks moved on today in yellow, the rest empty -->
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource HoverBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DayDoneWidth}" />
                                        <ColumnDefinition Width="{Binding DayPartWidth}" />
                                        <ColumnDefinition Width="{Binding DayLeftWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="3" Background="{DynamicResource DoneBrush}"
                                            Visibility="{Binding HasDayDone, Converter={StaticResource Visible}}" />
                                    <Border Grid.Column="1" CornerRadius="0,3,3,0" Background="{DynamicResource PartialBrush}"
                                            Visibility="{Binding HasDayPart, Converter={StaticResource Visible}}" />
                                </Grid>
                            </Border>
                        </DockPanel>
                        <!-- The day's counts as small labels beside the bar (alone when there is no bar), coloured as the bar and the list -->
                        <ItemsControl ItemsSource="{Binding DayChips}" Focusable="False" VerticalAlignment="Center"
                                      Visibility="{Binding HasDayChips, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Chip" CornerRadius="9" Padding="8,1,8,2" Margin="0,2,5,2" Background="{DynamicResource CellBrush}">
                                        <TextBlock x:Name="Words" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="done">
                                            <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource DoneBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="part">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PartialBrush}" />
                                            <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource OnPartialBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="open">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource OpenSoftBrush}" />
                                            <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource OpenBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Full month -->
                <Grid Grid.Row="1" Margin="34,0,34,0" Visibility="{Binding IsMonthScale, Converter={StaticResource Visible}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="7" Rows="1" Margin="5,0">
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pazartesi" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Salı" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Çarşamba" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Perşembe" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Cuma" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Cumartesi" Foreground="{DynamicResource WeekendBrush}" />
                        <TextBlock Style="{StaticResource WeekdayLabel}" Text="Pazar" Foreground="{DynamicResource WeekendBrush}" />
                    </UniformGrid>
                    <Border Grid.Row="1" Background="{DynamicResource CalendarCardBrush}" CornerRadius="10" Padding="5">
                    <ItemsControl ItemsSource="{Binding MonthCells}" ItemsPanel="{StaticResource MonthPanel}" Focusable="False"
                                  AutomationProperties.Name="Ay takvimi">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MonthDay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                </Grid>

                <!-- Week: seven columns side by side on a big window, the days one under the other on a small one -->
                <Grid Grid.Row="1" Visibility="{Binding IsWeekScale, Converter={StaticResource Visible}}">
                <ScrollViewer x:Name="WeekRows" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="34,0,34,0"
                              Visibility="Collapsed">
                    <Border Background="{DynamicResource CalendarCardBrush}" CornerRadius="10" Padding="6,6,6,0" Margin="0,0,0,12" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding WeekCards}" Focusable="False" AutomationProperties.Name="Hafta takvimi">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WeekCard}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                </ScrollViewer>
                <Border x:Name="WeekColumnsCard" Background="{DynamicResource CalendarCardBrush}" CornerRadius="10" Padding="3,6" Margin="31,0,31,12">
                <ItemsControl x:Name="WeekColumns" ItemsSource="{Binding WeekCards}" Focusable="False" AutomationProperties.Name="Hafta takvimi">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource WeekColumn}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Border>
                </Grid>

                <!-- Year: twelve small months; a month's name opens it, a day opens that day -->
                <ScrollViewer x:Name="YearScroll" Grid.Row="1" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="30,0,30,0"
                              Visibility="{Binding IsYearScale, Converter={StaticResource Visible}}" SizeChanged="YearScroll_SizeChanged">
                    <ItemsControl ItemsSource="{Binding YearCards}" Focusable="False" Margin="0,0,0,12" AutomationProperties.Name="Yıl takvimi">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" CornerRadius="8" BorderThickness="1.5" BorderBrush="Transparent" Background="{DynamicResource CalendarCardBrush}" Padding="8,6,8,8" Margin="4">
                                    <StackPanel>
                                        <Button Style="{StaticResource LinkButton}" Content="{Binding Name}" Command="{Binding OpenCommand}" HorizontalAlignment="Left"
                                                Foreground="{DynamicResource InkBrush}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,4"
                                                ToolTip="Bu ayı aç" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} ayını aç'}" />
                                        <UniformGrid Columns="7" Margin="0,0,0,2">
                                            <TextBlock Text="P" Style="{StaticResource YearLetter}" />
                                            <TextBlock Text="S" Style="{StaticResource YearLetter}" />
                                            <TextBlock Text="Ç" Style="{StaticResource YearLetter}" />
                                            <TextBlock Text="P" Style="{StaticResource YearLetter}" />
                                            <TextBlock Text="C" Style="{StaticResource YearLetter}" />
                                            <TextBlock Text="C" Style="{StaticResource YearLetter}" Foreground="{DynamicResource WeekendBrush}" />
                                            <TextBlock Text="P" Style="{StaticResource YearLetter}" Foreground="{DynamicResource WeekendBrush}" />
                                        </UniformGrid>
                                        <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource YearDay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource CellBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Day, open work, search -->
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent"
                              PreviewMouseWheel="ContentScroll_PreviewMouseWheel" Focusable="False" AllowDrop="True"
                              PreviewDragOver="ContentScroll_PreviewDragOver" PreviewDrop="ContentScroll_PreviewDrop"
                              PreviewDragLeave="ContentScroll_PreviewDragLeave"
                              Visibility="{Binding IsListView, Converter={StaticResource Visible}}">
                    <Grid Margin="36,0,26,12">
                        <StackPanel>
                        <!-- Each page keeps its rows; only the current one shows, so switching back does not build them again -->
<ItemsControl ItemsSource="{Binding PageLists}" Focusable="False">
<ItemsControl.ItemTemplate>
<DataTemplate>
<ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="GroupBox" CornerRadius="8" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Button x:Name="GroupTitle" Style="{StaticResource ButtonBase}" Command="{Binding OpenCommand}"
                                                    Padding="8,4" Margin="-8,0,0,8" HorizontalAlignment="Left" FontWeight="SemiBold"
                                                    Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding TitleToolTip}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    IsHitTestVisible="{Binding HasCommand}" Focusable="{Binding HasCommand}"
                                                    Visibility="{Binding HasTitle, Converter={StaticResource Visible}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="GroupChevron" Data="{StaticResource IconDown}" Width="16" Height="16" Margin="0,0,6,0"
                                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBlock Text="{Binding Title}" />
                                                    <Path x:Name="DoneChevron" Data="{StaticResource IconRight}" Width="14" Height="14" Margin="6,0,0,0" Stretch="Uniform"
                                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding EmptyText}" FontSize="15" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                                                       TextWrapping="Wrap" Visibility="{Binding ShowEmptyText, Converter={StaticResource Visible}}" />
                                            <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}" Focusable="False"
                                                          Visibility="{Binding ShowEntries, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsible}" Value="True">
                                            <Setter TargetName="GroupBox" Property="Background" Value="{DynamicResource CellBrush}" />
                                            <Setter TargetName="GroupBox" Property="Margin" Value="-24,10,-8,14" />
                                            <Setter TargetName="GroupBox" Property="Padding" Value="24,12,8,0" />
                                            <Setter TargetName="GroupTitle" Property="FontSize" Value="14" />
                                            <Setter TargetName="GroupTitle" Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Setter TargetName="GroupChevron" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter TargetName="GroupChevron" Property="Data" Value="{StaticResource IconRight}" />
                                        </DataTrigger>
                                        <!-- The day's finished work: a thin line, green "✓ 4 iş bitti" and an arrow after it -->
                                        <DataTrigger Binding="{Binding IsDoneFold}" Value="True">
                                            <Setter TargetName="GroupBox" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                            <Setter TargetName="GroupBox" Property="BorderThickness" Value="0,1,0,0" />
                                            <Setter TargetName="GroupBox" Property="CornerRadius" Value="0" />
                                            <Setter TargetName="GroupBox" Property="Padding" Value="0,8,0,0" />
                                            <Setter TargetName="GroupTitle" Property="Foreground" Value="{DynamicResource DoneBrush}" />
                                            <Setter TargetName="GroupTitle" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="DoneChevron" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDoneFold}" Value="True" />
                                                <Condition Binding="{Binding IsCollapsed}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="DoneChevron" Property="Data" Value="{StaticResource IconDown}" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>

                        <!-- Worked on this day, sitting under another day now: as it stood that evening, only what was finished here -->
                        <ItemsControl x:Name="EchoList" ItemsSource="{Binding EchoRows}" Focusable="False" Margin="0,0,0,8"
                                      Visibility="{Binding HasEchoRows, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding OpenCommand}" Cursor="Hand" Margin="-10,0,-10,6" Foreground="{DynamicResource InkBrush}"
                                            ToolTip="İşin durduğu günü aç" AutomationProperties.Name="{Binding Title}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,7">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="EchoNote" DockPanel.Dock="Right" Text="{Binding Note}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <!-- The count with an arrow, as on the task's own row: folds the sub-tasks away -->
                                                <Button DockPanel.Dock="Right" Command="{Binding ToggleCommand}" Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="{Binding FoldTip}" AutomationProperties.Name="{Binding FoldTip}" IsEnabled="{Binding CanFold}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="4,2,2,2">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Count}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                        <Path Width="16" Height="16" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Stroke="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                                              Visibility="{Binding CanFold, Converter={StaticResource Visible}}">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IconDown}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IconRight}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </StackPanel>
                                                </Button>
                                                <Border x:Name="EchoBox" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource PartialBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock x:Name="EchoMark" Text="–" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnPartialBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding DoneHere}" Focusable="False" Margin="28,4,0,0"
                                                          Visibility="{Binding ShowDoneHere, Converter={StaticResource Visible}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <Border Width="15" Height="15" CornerRadius="3" Background="{DynamicResource DoneBrush}" VerticalAlignment="Center" Margin="0,0,9,0">
                                                                <TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding}" FontSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TaskDoneHere}" Value="True">
                                            <Setter TargetName="EchoBox" Property="Background" Value="{DynamicResource DoneBrush}" />
                                            <Setter TargetName="EchoMark" Property="Text" Value="✓" />
                                            <Setter TargetName="EchoMark" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoteDone}" Value="True">
                                            <Setter TargetName="EchoNote" Property="Foreground" Value="{DynamicResource DoneBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding EmptyText}" FontSize="15" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                    </Grid>
                </ScrollViewer>

                <StackPanel x:Name="BottomPanel" Grid.Row="2" Margin="36,8,36,16">
                    <!-- Waiting for a day to be clicked in a calendar -->
                    <Border Background="{DynamicResource CellBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,8" Visibility="{Binding IsPickingDay, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Vazgeç" VerticalAlignment="Center"
                                    Command="{Binding CancelPickDayCommand}" ToolTip="Esc" />
                            <TextBlock Text="{Binding PickingText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Bulk moves for the selected rows -->
                    <Border Background="{DynamicResource CellBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding ShowSelectionBar, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Seçimi kaldır" VerticalAlignment="Center"
                                    Command="{Binding ClearSelectionCommand}" ToolTip="Esc" />
                            <TextBlock Text="{Binding SelectionText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Bugüne al" Command="{Binding BringSelectedToTodayCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Yarına taşı" Command="{Binding MoveSelectedToTomorrowCommand}" Margin="8,0,0,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Tarihsiz yap" Command="{Binding MakeSelectedUndatedCommand}" Margin="8,0,0,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Başka güne taşı" Command="{Binding PickDayForSelectedCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,8" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Geri al"
                                Command="{Binding UndoCommand}" ToolTip="Ctrl+Z"
                                Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" />
                        <!-- The task went to a day not on screen: a way to follow it -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasAddedElsewhere, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource LinkButton}" Content="{Binding ShowAddedDayText}" Command="{Binding ShowAddedDayCommand}" VerticalAlignment="Center" />
                            <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- What the calendar colours mean -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCalendarView, Converter={StaticResource Visible}}">
                        <TextBlock Text="Biten iş: 1-2" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource Heat1Brush}" />
                        <TextBlock Text="3-4" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource Heat2Brush}" />
                        <TextBlock Text="5 ve üzeri" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource Heat3Brush}" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource OpenBrush}" VerticalAlignment="Center" Margin="22,0,6,0" />
                        <TextBlock Text="Tamamlanmamış" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- The add box: one line while idle; opened, the day, a description and sub-tasks before Ekle -->
                    <Border x:Name="Composer" Visibility="{Binding IsListView, Converter={StaticResource Visible}}"
                            Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False"
                            CornerRadius="8" BorderThickness="1" Padding="11,9,11,9"
                            PreviewKeyDown="Composer_PreviewKeyDown" GotKeyboardFocus="Composer_GotKeyboardFocus"
                            MouseLeftButtonUp="Composer_MouseLeftButtonUp" IsKeyboardFocusWithinChanged="Composer_IsKeyboardFocusWithinChanged">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CellBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                <Setter Property="Cursor" Value="IBeam" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsComposerOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="19" Height="19" CornerRadius="9.5" BorderThickness="1.75" Margin="0,0,9,0"
                                        BorderBrush="{DynamicResource AccentBrush}" VerticalAlignment="Top"
                                        Visibility="{Binding IsTextWriting, Converter={StaticResource Visible}}">
                                    <Path Data="M 5,1.5 L 5,8.5 M 1.5,5 L 8.5,5" Width="10" Height="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="ShortcutsButton" DockPanel.Dock="Right" Content="Kısayollar (F1)" Command="{Binding ToggleHelpCommand}"
                                        VerticalAlignment="Center" Margin="8,-4,-6,-4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsComposerOpen}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ComposerSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding HasComposerSummary, Converter={StaticResource Visible}}" />
                                <!-- The visual box: the task as the list will show it; closed, only its title -->
                                <local:TaskLinesEditor x:Name="DraftEditor" Text="{Binding DraftText}" Placeholder="{Binding DraftEditorHint}"
                                                       OnlyTitle="{Binding IsComposerClosed}"
                                                       GotKeyboardFocus="DraftBox_GotKeyboardFocus" AutomationProperties.Name="{Binding AddHint}"
                                                       Visibility="{Binding IsVisualWriting, Converter={StaticResource Visible}}" />
                                <Grid Visibility="{Binding IsTextWriting, Converter={StaticResource Visible}}">
                                    <TextBox x:Name="DraftBox" Style="{StaticResource ComposerTitleBox}" AcceptsReturn="True" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="DraftBox_PreviewKeyDown" GotKeyboardFocus="DraftBox_GotKeyboardFocus" VerticalAlignment="Center"
                                             AutomationProperties.Name="{Binding AddHint}" />
                                    <TextBlock FontSize="14" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Text" Value="{Binding AddHint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DraftBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsComposerOpen}" Value="True">
                                                        <Setter Property="Text" Value="İşin adını yaz…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>

                            <StackPanel Margin="28,0,0,0" Visibility="{Binding IsComposerOpen, Converter={StaticResource Visible}}">
                                <!-- Description: one line under the title -->
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding IsDescriptionOpen, Converter={StaticResource Visible}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" Padding="4"
                                            Margin="4,0,-4,0" VerticalAlignment="Center" Command="{Binding RemoveDescriptionCommand}"
                                            ToolTip="Açıklamayı kaldır" AutomationProperties.Name="Açıklamayı kaldır" />
                                    <Grid>
                                        <TextBox x:Name="ComposerDescriptionBox" Style="{StaticResource ComposerFieldBox}"
                                                 Text="{Binding ComposerDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="ComposerDescriptionBox_PreviewKeyDown" GotKeyboardFocus="ComposerDescriptionBox_GotKeyboardFocus"
                                                 AutomationProperties.Name="Açıklama" />
                                        <TextBlock Text="Açıklama yaz…" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ComposerDescriptionBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>

                                <!-- Sub-tasks written so far, then the line for the next one -->
                                <ItemsControl ItemsSource="{Binding ComposerSubTasks}" Focusable="False" Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ComposerSubTasks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel x:Name="SubRow" Background="Transparent">
                                                <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" BorderThickness="1.5" Margin="1,0,9,0"
                                                        BorderBrush="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                <Button x:Name="RemoveSub" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}"
                                                        Padding="3" Margin="4,0,-3,0" Opacity="0.6" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveComposerSubTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Bu alt işi sil" AutomationProperties.Name="Alt işi sil" />
                                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="SubRow" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RemoveSub" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0" Visibility="{Binding IsSubTaskEntryOpen, Converter={StaticResource Visible}}">
                                    <TextBox x:Name="ComposerSubTaskBox" Style="{StaticResource ComposerFieldBox}" Padding="24,5,8,5"
                                             Text="{Binding SubTaskEntryText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="ComposerSubTaskBox_PreviewKeyDown" GotKeyboardFocus="ComposerSubTaskBox_GotKeyboardFocus"
                                             AutomationProperties.Name="Alt iş" />
                                    <Path Data="M 5,1.5 L 5,8.5 M 1.5,5 L 8.5,5" Width="10" Height="10" Margin="9,0,0,0" HorizontalAlignment="Left"
                                          VerticalAlignment="Center" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" IsHitTestVisible="False" />
                                    <TextBlock Text="Alt iş yaz, Enter" FontSize="13" Margin="26,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ComposerSubTaskBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Day, sub-task and description buttons -->
                                <WrapPanel x:Name="ComposerChips" Margin="0,8,0,0">
                                    <Button x:Name="ComposerDayButton" Style="{StaticResource Chip}" Margin="0,0,6,0" Click="ComposerDayButton_Click"
                                            ToolTip="İşin günü: Bugün, Yarın, Tarihsiz ya da takvimden bir gün"
                                            AutomationProperties.Name="{Binding ComposerDayText, StringFormat='Gün: {0}'}">
                                        <Button.Tag>
                                            <sys:Boolean>True</sys:Boolean>
                                        </Button.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCalendar}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.3" Margin="0,0,6,0"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding ComposerDayText}" VerticalAlignment="Center" />
                                            <Path Data="{StaticResource IconDown}" Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.4" Margin="6,1,0,0"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="＋ Açıklama" Margin="0,0,6,0" Click="ComposerNoteChip_Click" ToolTip="{Binding ComposerNoteChipTip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComposerHasNote}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="＋ Alt iş" Margin="0,0,6,0" Click="ComposerSubTaskChip_Click" ToolTip="{Binding ComposerSubTaskChipTip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubTaskEntryOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>

                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ComposerKeyHint}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Margin="0,0,8,0">
                                            <Border CornerRadius="8" Margin="-3" BorderThickness="3" BorderBrush="{DynamicResource AccentEdgeBrush}"
                                                    Visibility="{Binding IsAddHighlighted, Converter={StaticResource Visible}}" />
                                            <Button x:Name="ComposerAddButton" Style="{StaticResource PrimaryButton}" Content="Ekle" Padding="14,5"
                                                    Command="{Binding SubmitComposerCommand}" IsEnabled="{Binding CanAddComposer}"
                                                    ToolTip="Enter. Yapıldı olarak eklemek için Ctrl+Enter" />
                                        </Grid>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" Padding="14,5" Command="{Binding DiscardComposerCommand}"
                                                ToolTip="Yazılanları silip kutuyu kapatır. Saklayıp küçültmek için Esc ya da dışarı bas" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Shortcut list -->
        <Grid x:Name="HelpScrim" Background="#80000000" Visibility="{Binding IsHelpOpen, Converter={StaticResource Visible}}" IsVisibleChanged="HelpScrim_IsVisibleChanged" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">
            <!-- Tabs by subject, a search over all of them on top; the same grey page and white cards as Settings -->
            <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Width="600" Height="520" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,16,20,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}"
                                Command="{Binding ToggleHelpCommand}" ToolTip="Kapat (Esc)" AutomationProperties.Name="Kısayolları kapat" />
                        <TextBlock Text="Kısayollar" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="20,0,20,10">
                        <TextBox x:Name="ShortcutSearch" Style="{StaticResource InputBox}" FontSize="14" Padding="32,7,90,7"
                                 Text="{Binding ShortcutQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kısayol ara" />
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Kısayol ara… (örn. taşı, gün, F2)" FontSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="34,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding IsShortcutSearching, Converter={StaticResource Collapsed}}" />
                        <TextBlock Text="{Binding ShortcutResult}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                    </Grid>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ShortcutTabs}" Focusable="False" Margin="20,0,20,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding PickCommand}" Cursor="Hand" Focusable="False" AutomationProperties.Name="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="Transparent" CornerRadius="6,6,0,0" Padding="12,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Text="{Binding Found}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource CellBrush}" />
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource CellBrush}" CornerRadius="0,0,8,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding ShortcutSections}" Focusable="False" Margin="18,14,18,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsGroup}"
                                                       Visibility="{Binding ShowTitle, Converter={StaticResource Visible}}" />
                                            <Border Style="{StaticResource SettingsCard}">
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <DockPanel Margin="14,8">
                                                                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Keys}" Focusable="False" Width="210" VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <!-- A key cap -->
                                                                                <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                        BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,1" Margin="0,2,4,2" MinWidth="24">
                                                                                    <TextBlock Text="{Binding}" FontSize="12.5" HorizontalAlignment="Center" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
<TextBlock FontSize="13.5" TextWrapping="Wrap"><Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Hit, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding After, Mode=OneWay}" /></TextBlock>
<TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
</StackPanel>
                                                                </DockPanel>
                                                                <Border Style="{StaticResource SettingsDivider}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Settings -->
        <Grid x:Name="SettingsScrim" Background="#80000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource Visible}}" IsVisibleChanged="SettingsScrim_IsVisibleChanged" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">
            <!-- At most 500 high, shrinks with a short window; the right side scrolls, so switching sections keeps the size. -->
            <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Width="640" MaxHeight="500" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="0,0,0,1" Padding="24,16,20,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconClose}"
                                    Command="{Binding ToggleSettingsCommand}" ToolTip="Kapat (Esc)" AutomationProperties.Name="Ayarları kapat" />
                            <TextBlock Text="Ayarlar" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Left" Width="160" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="0,0,1,0" Padding="10,12">
                        <DockPanel>
                            <!-- The developer goes by the nickname only, on a fainter line under the version -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,2">
                                <TextBlock Text="{Binding AppVersion, StringFormat='Sürüm {0}'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock FontSize="11.5" Margin="0,1,0,0"><Run Text="created by " Foreground="{DynamicResource MutedBrush}" /><Run Text="antagonist.g" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <RadioButton x:Name="SettingsTabLook" Style="{StaticResource SettingsTab}" GroupName="SettingsTabs" Content="Görünüm" IsChecked="True" />
                                <RadioButton x:Name="SettingsTabBehave" Style="{StaticResource SettingsTab}" GroupName="SettingsTabs" Content="Davranış" />
                                <RadioButton x:Name="SettingsTabSync" Style="{StaticResource SettingsTab}" GroupName="SettingsTabs" Content="Eşitleme" />
                                <RadioButton x:Name="SettingsTabHelp" Style="{StaticResource SettingsTab}" GroupName="SettingsTabs" Content="Yardım" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Background="{DynamicResource CellBrush}">
                    <Grid Margin="18,16,18,4">

                    <!-- Görünüm -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SettingsTabLook, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentButton}" Content="Sistem" Command="{Binding UseSystemThemeCommand}" Tag="{Binding IsSystemTheme}" AutomationProperties.Name="Sistem teması" />
                                            <Button Style="{StaticResource SegmentButton}" Content="Açık" Command="{Binding UseLightThemeCommand}" Tag="{Binding IsLightTheme}" AutomationProperties.Name="Açık tema" />
                                            <Button Style="{StaticResource SegmentButton}" Content="Koyu" Command="{Binding UseDarkThemeCommand}" Tag="{Binding IsDarkThemeChosen}" AutomationProperties.Name="Koyu tema" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Tema" Style="{StaticResource SettingsName}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}" />
                                <DockPanel Style="{StaticResource SettingsRow}">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentButton}" Content="Yeni" Command="{Binding UseNewSidebarCommand}" Tag="{Binding IsNewSidebar}" AutomationProperties.Name="Yeni sol panel" />
                                            <Button Style="{StaticResource SegmentButton}" Content="Klasik" Command="{Binding UseClassicSidebarCommand}" Tag="{Binding IsClassicSidebar}" AutomationProperties.Name="Klasik sol panel" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Sol panel" Style="{StaticResource SettingsName}" />
