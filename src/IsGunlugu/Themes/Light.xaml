<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#FBFBFA" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F1F1EE" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C9C9C4" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E7E7E3" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#DEDFDA" />
    <SolidColorBrush x:Key="InkBrush" Color="#1D1E1C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#62645F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0B6A6F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#08565A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DoneBrush" Color="#2F7D4F" />
    <SolidColorBrush x:Key="OpenBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#BDBEB8" />
    <SolidColorBrush x:Key="PartialBrush" Color="#E3AE1F" />
    <SolidColorBrush x:Key="OnPartialBrush" Color="#2B2205" />
    <SolidColorBrush x:Key="CellBrush" Color="#F1F1EE" />
    <!-- The calendar pages (week, month, year): a card behind the days, each day a square on it. In the light theme the card keeps the white squares apart from the page. -->
    <SolidColorBrush x:Key="CalendarCardBrush" Color="#F1F1EE" />
    <SolidColorBrush x:Key="CalendarDayBrush" Color="#FFFFFF" />
    <!-- The task the keyboard is on (arrows, Tab): a light accent wash. -->
    <SolidColorBrush x:Key="KeyRowBrush" Color="#E3F0F0" />
    <SolidColorBrush x:Key="WeekendBrush" Color="#C62828" />
    <SolidColorBrush x:Key="Heat1Brush" Color="#DCEFE2" />
    <SolidColorBrush x:Key="Heat2Brush" Color="#B9E0C7" />
    <SolidColorBrush x:Key="Heat3Brush" Color="#8FCDA7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="OpenSoftBrush" Color="#FBE7DC" />
    <SolidColorBrush x:Key="OpenEdgeBrush" Color="#E9B79D" />
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#9CCBCC" />
</ResourceDictionary>
