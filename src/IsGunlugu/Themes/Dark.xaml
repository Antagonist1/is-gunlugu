<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#1B1C1A" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#232422" />
    <SolidColorBrush x:Key="InputBrush" Color="#2A2B29" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4A4C48" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2F302E" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#3A3C39" />
    <SolidColorBrush x:Key="InkBrush" Color="#ECECE8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A6A8A2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#56C2C4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AD3D4" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0D2526" />
    <SolidColorBrush x:Key="DoneBrush" Color="#5DBB83" />
    <SolidColorBrush x:Key="OpenBrush" Color="#F08A5D" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#555752" />
    <SolidColorBrush x:Key="PartialBrush" Color="#EBBC3F" />
    <SolidColorBrush x:Key="OnPartialBrush" Color="#2B2205" />
    <SolidColorBrush x:Key="CellBrush" Color="#232422" />
    <!-- The calendar pages (week, month, year): a card behind the days, each day a square on it. In the light theme the card keeps the white squares apart from the page. -->
    <SolidColorBrush x:Key="CalendarCardBrush" Color="Transparent" />
    <SolidColorBrush x:Key="CalendarDayBrush" Color="#232422" />
    <!-- The task the keyboard is on (arrows, Tab): a light accent wash. -->
    <SolidColorBrush x:Key="KeyRowBrush" Color="#1F3637" />
    <SolidColorBrush x:Key="WeekendBrush" Color="#F0736B" />
    <SolidColorBrush x:Key="Heat1Brush" Color="#25402F" />
    <SolidColorBrush x:Key="Heat2Brush" Color="#2E5A40" />
    <SolidColorBrush x:Key="Heat3Brush" Color="#3A7652" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="OpenSoftBrush" Color="#3A2A22" />
    <SolidColorBrush x:Key="OpenEdgeBrush" Color="#6B3A24" />
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#2F6B6C" />
</ResourceDictionary>
