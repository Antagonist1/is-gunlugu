<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>İş Günlüğü</AssemblyTitle>
    <Product>İş Günlüğü</Product>
    <Version>0.8.5</Version>
    <Authors>antagonist.g</Authors>
    <Company>antagonist.g</Company>
    <Copyright>© 2026 antagonist.g</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- No exe.config: the exe runs on the 4.8 every Windows 10 and 11 has, and stays a single file. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\IsGunlugu.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Resource Include="app.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="..\..\docs\kaynak\goruntu\*.png" LogicalName="guide.%(Filename)%(Extension)" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
